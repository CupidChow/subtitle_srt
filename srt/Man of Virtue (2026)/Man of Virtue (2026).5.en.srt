561
00:44:55,000 --> 00:44:56,480
<c.bg_transparent><c.white>Look, right down there.</c.white></c.bg_transparent>

562
00:45:16,840 --> 00:45:18,400
<c.bg_transparent><c.white>Hey, over there!</c.white></c.bg_transparent>

563
00:45:21,000 --> 00:45:23,000
<c.bg_transparent><c.white>The fake monk who was with Chansuek.</c.white></c.bg_transparent>

564
00:45:31,040 --> 00:45:32,480
<c.bg_transparent><c.white>Hey, hold on.</c.white></c.bg_transparent>

565
00:45:34,960 --> 00:45:36,280
<c.bg_transparent><c.white>Where is Chansuek?</c.white></c.bg_transparent>

566
00:45:39,080 --> 00:45:40,040
<c.bg_transparent><c.white>I think</c.white></c.bg_transparent>

567
00:45:40,640 --> 00:45:42,320
<c.bg_transparent><c.white>don't be hot-headed just yet.</c.white></c.bg_transparent>

568
00:45:42,920 --> 00:45:44,560
<c.bg_transparent><c.white>We haven't found Chansuek anyway.</c.white></c.bg_transparent>

569
00:45:46,720 --> 00:45:48,160
<c.bg_transparent><c.white>Let's tail the monk first.</c.white></c.bg_transparent>

570
00:45:48,840 --> 00:45:49,680
<c.bg_transparent><c.white>Okay?</c.white></c.bg_transparent>

571
00:46:05,000 --> 00:46:07,920
<c.bg_transparent><c.white>Once we save everyone,</c.white></c.bg_transparent>
<c.bg_transparent><c.white>I'll send someone to untie you.</c.white></c.bg_transparent>

572
00:46:09,800 --> 00:46:12,760
<c.bg_transparent><c.white>What? What are you trying to say?</c.white></c.bg_transparent>

573
00:46:13,360 --> 00:46:14,720
<c.bg_transparent><c.white>What if you guys die?</c.white></c.bg_transparent>

574
00:46:14,800 --> 00:46:16,720
<c.bg_transparent><c.white>-Keep talking trash and take this!</c.white></c.bg_transparent>
<c.bg_transparent><c.white>-Hey!</c.white></c.bg_transparent>

575
00:46:16,800 --> 00:46:18,120
<c.bg_transparent><c.white>Take it easy, Boonrod.</c.white></c.bg_transparent>

576
00:46:20,160 --> 00:46:23,000
<c.bg_transparent><c.white>We're already terrified,</c.white></c.bg_transparent>
<c.bg_transparent><c.white>and you just had to say that.</c.white></c.bg_transparent>

577
00:46:23,640 --> 00:46:24,480
<c.bg_transparent><c.white>Yeah.</c.white></c.bg_transparent>

578
00:46:26,160 --> 00:46:27,560
<c.bg_transparent><c.white>No more talking.</c.white></c.bg_transparent>

579
00:46:31,280 --> 00:46:32,920
<c.bg_transparent><c.white>Let's move.</c.white></c.bg_transparent>

580
00:46:42,280 --> 00:46:43,640
<c.bg_transparent><c.white>I'm starving.</c.white></c.bg_transparent>

581
00:46:43,720 --> 00:46:46,200
<c.bg_transparent><c.white>Why am I so unusually hungry today?</c.white></c.bg_transparent>

582
00:46:47,120 --> 00:46:50,120
<c.bg_transparent><c.white>It's going to be ages</c.white></c.bg_transparent>
<c.bg_transparent><c.white>before the next shift comes.</c.white></c.bg_transparent>

583
00:46:50,200 --> 00:46:52,000
<c.bg_transparent><c.white>Man, so hungry!</c.white></c.bg_transparent>

584
00:47:01,280 --> 00:47:03,080
<c.bg_transparent><c.white>How are we going to get in?</c.white></c.bg_transparent>

585
00:47:03,160 --> 00:47:04,480
<c.bg_transparent><c.white>There are guards everywhere.</c.white></c.bg_transparent>

586
00:47:06,800 --> 00:47:07,640
<c.bg_transparent><c.white>Exactly.</c.white></c.bg_transparent>

587
00:47:10,520 --> 00:47:11,640
<c.bg_transparent><c.white>Just take a gamble.</c.white></c.bg_transparent>

588
00:47:12,400 --> 00:47:14,680
<c.bg_transparent><c.white>No guts, no glory.</c.white></c.bg_transparent>

589
00:47:22,520 --> 00:47:23,720
<c.bg_transparent><c.white>Are you serious?</c.white></c.bg_transparent>

590
00:47:28,720 --> 00:47:29,560
<c.bg_transparent><c.white>Let's go.</c.white></c.bg_transparent>

591
00:47:45,480 --> 00:47:47,960
<c.bg_transparent><c.white>Hey, how's everything on your side?</c.white></c.bg_transparent>

592
00:47:48,040 --> 00:47:49,240
<c.bg_transparent><c.white>It's quiet over on my end.</c.white></c.bg_transparent>

593
00:48:03,440 --> 00:48:06,200
<c.bg_transparent><c.white>Since you're in my town,</c.white></c.bg_transparent>
<c.bg_transparent><c.white>let me welcome you.</c.white></c.bg_transparent>

594
00:48:06,280 --> 00:48:08,320
<c.bg_transparent><c.white>As long as I'm here,</c.white></c.bg_transparent>

595
00:48:09,040 --> 00:48:11,840
<c.bg_transparent><c.white>I won't let anyone be above the law.</c.white></c.bg_transparent>

596
00:48:13,280 --> 00:48:14,840
<c.bg_transparent><c.white>Everyone, stay here.</c.white></c.bg_transparent>

597
00:48:14,920 --> 00:48:16,120
<c.bg_transparent><c.white>I'm going in with the chief.</c.white></c.bg_transparent>

598
00:48:16,200 --> 00:48:20,280
<c.bg_transparent><c.white>NEXT EPISODE</c.white></c.bg_transparent>

599
00:48:20,360 --> 00:48:22,560
<c.bg_transparent><c.white>-Keep low.</c.white></c.bg_transparent>
<c.bg_transparent><c.white>-Move! Take cover!</c.white></c.bg_transparent>

600
00:48:24,320 --> 00:48:25,600
<c.bg_transparent><c.white>Luang Pho!</c.white></c.bg_transparent>

601
00:48:27,520 --> 00:48:28,480
<c.bg_transparent><c.white>What division are you in?</c.white></c.bg_transparent>

602
00:48:28,560 --> 00:48:29,560
<c.bg_transparent><c.white>Take the mask off.</c.white></c.bg_transparent>

603
00:48:31,040 --> 00:48:35,040
<c.bg_transparent><c.white>I'm asking for your mercy</c.white></c.bg_transparent>
<c.bg_transparent><c.white>to release all the captured people.</c.white></c.bg_transparent>

604
00:48:35,960 --> 00:48:37,160
<c.bg_transparent><c.white>Hey!</c.white></c.bg_transparent>

605
00:51:46,720 --> 00:51:51,720
<c.bg_transparent><c.white>Subtitle translation by: Jarut K.</c.white></c.bg_transparent>
