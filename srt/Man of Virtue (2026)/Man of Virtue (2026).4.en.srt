<c.bg_transparent><c.white>Son,</c.white></c.bg_transparent>

146
00:11:12,400 --> 00:11:15,040
<c.bg_transparent><c.white>we must call Lek Muang Khon in to help us.</c.white></c.bg_transparent>

147
00:11:15,840 --> 00:11:16,800
<c.bg_transparent><c.white>Good idea, Dad.</c.white></c.bg_transparent>

148
00:11:18,360 --> 00:11:19,360
<c.bg_transparent><c.white>Make this ID</c.white></c.bg_transparent>

149
00:11:19,960 --> 00:11:21,120
<c.bg_transparent><c.white>a wanted poster.</c.white></c.bg_transparent>

150
00:11:21,720 --> 00:11:24,280
<c.bg_transparent><c.white>Offer a reward to anyone</c.white></c.bg_transparent>
<c.bg_transparent><c.white>who spots or catches him.</c.white></c.bg_transparent>

151
00:11:24,360 --> 00:11:25,480
<c.bg_transparent><c.white>Go.</c.white></c.bg_transparent>

152
00:11:27,400 --> 00:11:28,760
<c.bg_transparent><c.white>Got it, Dad.</c.white></c.bg_transparent>

153
00:12:00,040 --> 00:12:02,040
<c.bg_transparent><c.white>WANTED</c.white></c.bg_transparent>

154
00:12:08,120 --> 00:12:09,000
<c.bg_transparent><c.white>Let's go.</c.white></c.bg_transparent>

155
00:12:24,680 --> 00:12:26,840
<c.bg_transparent><c.white>Oh, they're all in there.</c.white></c.bg_transparent>

156
00:12:26,920 --> 00:12:27,920
<c.bg_transparent><c.white>Let's do it.</c.white></c.bg_transparent>

157
00:12:45,760 --> 00:12:46,840
<c.bg_transparent><c.white>Move.</c.white></c.bg_transparent>

158
00:12:56,640 --> 00:12:58,200
<c.bg_transparent><c.white>Wait for the gas.</c.white></c.bg_transparent>

159
00:12:58,280 --> 00:13:00,960
<c.bg_transparent><c.white>Once they pass out, we will grab them.</c.white></c.bg_transparent>

160
00:13:07,720 --> 00:13:09,000
<c.bg_transparent><c.white>Hey, it's working.</c.white></c.bg_transparent>

161
00:13:09,080 --> 00:13:10,080
<c.bg_transparent><c.white>Move in!</c.white></c.bg_transparent>

