186
00:14:50,680 --> 00:14:52,960
<c.bg_transparent><c.white>No one can escape the law of karma.</c.white></c.bg_transparent>

187
00:14:54,240 --> 00:14:55,200
<c.white><c.bg_transparent><i>Sadhu.</i></c.bg_transparent></c.white>

188
00:14:59,800 --> 00:15:01,000
<c.bg_transparent><c.white>Careful.</c.white></c.bg_transparent>

189
00:15:01,680 --> 00:15:02,880
<c.bg_transparent><c.white>Careful, Luang Pho.</c.white></c.bg_transparent>

190
00:15:04,040 --> 00:15:05,040
<c.bg_transparent><c.white>Watch your step.</c.white></c.bg_transparent>

191
