អ្នកស្ទើរតែធ្វើឱ្យខ្ញុំវង្វេង។

965
00:26:05,800 --> 00:26:07,040
យើង​មាន​ចិត្ត​ទូលាយ។

966
00:26:07,040 --> 00:26:08,920
ចូរ​ទុក​ឱ្យ​ពួក​គេ​មួយ​ភ្លៅ។

967
00:26:08,920 --> 00:26:09,800
នៅទីនេះ មួយនេះ។

968
00:26:09,800 --> 00:26:10,560
ខ្ញុំគិតថា Hewen

969
00:26:10,560 --> 00:26:11,680
អាចបំផ្លាញពួកគេដោយភាពឯកោ។

970
00:26:11,960 --> 00:26:12,440
តើខ្ញុំគួរយកវាទេ?

971
00:26:12,440 --> 00:26:13,840
នោះហើយជាអ្វីដែលអ្នកត្រូវការដើម្បីកំទេចពួកគេ។

972
00:26:17,160 --> 00:26:18,200
ស្មានតែខ្ញុំនឹងយកមួយនេះ។

973
00:26:18,200 --> 00:26:19,000
អ្នក​លេង​ការពារ​។

974
00:26:19,480 --> 00:26:20,080
ប្រាកដ។

975
00:26:20,080 --> 00:26:20,920
ការពារគ្រប់មធ្យោបាយ។

976
00:26:21,680 --> 00:26:22,560
យក​កូន​កុក​ឡើង។

977
00:26:23,600 --> 00:26:24,520
បោះវាចូលទៅក្នុង wok

978
00:26:24,520 --> 00:26:26,080
ហើយ​ឱ្យ​វា​កូរ​ឱ្យ​ឆ្អិន​។

979
00:26:26,080 --> 00:26:27,670
(ហាហាហា) ត្រៀមបម្រើ។

980
00:26:27,720 --> 00:26:29,500
មានអារម្មណ៍ត្រជាក់ជាង?

981
00:26:29,500 --> 00:26:32,680
(កង្ហារជាមួយ spatula)

982
00:26:32,680 --> 00:26:34,600
អ្នកអាចប្រើវាជាកញ្ចក់។

983
00:26:40,160 --> 00:26:40,920
បន្ទាប់មកភ្លេច wok ។

984
00:26:40,920 --> 00:26:42,040
យើងល្អជាមួយទាំងនេះ។

985
00:26:42,480 --> 00:26:43,840
តោះទៅ។

986
00:26:44,720 --> 00:26:45,480
បង្ហាញយើង។

987
00:26:45,600 --> 00:26:46,400
បង្ហាញយើង។

988
00:26:46,400 --> 00:26:47,080
(ជ្រើសរើសរ៉ាកែត)

989
00:26:47,080 --> 00:26:47,680
នេះគួរឱ្យអស់សំណើចណាស់។

990
00:26:47,680 --> 00:26:48,360
មកដល់ហើយ ក្រុមការងារផ្ទះបាយ។

991
00:26:48,360 --> 00:26:49,040
នាវិកផ្ទះបាយ។

992
00:26:49,480 --> 00:26:49,920
តើអ្នកចង់ញ៉ាំអ្វី?

993
00:26:49,920 --> 00:26:50,880
ខ្ញុំនឹងលើកចានពីរបីនៅពេលក្រោយ។

994
00:26:51,080 --> 00:26:51,880
ស្តាប់ទៅល្អ។

995
00:26:52,080 --> 00:26:53,840
ក្រុមចាញ់ត្រូវញ៉ាំក្រូចឆ្មា។

996
00:26:53,840 --> 00:26:55,280
(ចាញ់ការពិន័យរបស់ក្រុម៖ ញ៉ាំក្រូចឆ្មា) តើយើងលេងមួយទល់នឹងមួយ ឬ...

997
00:26:55,400 --> 00:26:56,400
យើង​អាច​ធ្វើ​មួយ​ទល់​នឹង​មួយ។

998
00:26:56,400 --> 00:26:57,480
និងពីរទល់នឹងពីរ។ យ៉ាង​ម៉េច​ដែរ?

999
00:26:57,480 --> 00:26:58,280
ប្រាកដ។

1000
00:26:58,280 --> 00:26:58,680
នោះធ្វើការ។

1001
00:26:58,680 --> 00:26:58,960
មិនអីទេ។

1002
00:26:58,960 --> 00:26:59,480
ការប្រកួតក្រុម។

1003
00:26:59,480 --> 00:27:01,000
មួយទល់នឹងមួយ ពីរលើពីរ បីទល់នឹងបី។

1004
00:27:01,080 --> 00:27:02,040
ដូច្នេះ មួយ​ទល់​មួយ​មុន​?

1005
00:27:02,040 --> 00:27:02,560
មិនអីទេ។

1006
00:27:02,760 --> 00:27:04,520
ប្រធានក្រុម ជ្រើសរើសការប្រកួតរបស់អ្នកដោយប្រាជ្ញា។

1007
00:27:05,080 --> 00:27:06,200
ប្រាកដណាស់ Hewen ។

1008
00:27:06,200 --> 00:27:06,800
ចាំនេះ...

1009
00:27:06,800 --> 00:27:08,080
Hewen តើវានឹងដំណើរការទេ?

1010
00:27:08,080 --> 00:27:09,120
វាស្រាលបន្តិច។ អនុញ្ញាតឱ្យខ្ញុំសាកល្បងវា។

1011
00:27:09,120 --> 00:27:10,040
នៅទីនេះ។ មួយនេះល្អណាស់។

1012
00:27:10,040 --> 00:27:11,240
មួយនេះល្អណាស់។

1013
00:27:11,240 --> 00:27:11,840
តើអ្នកអាចលេងជាមួយនេះបានទេ?

1014
00:27:11,840 --> 00:27:12,720
(Team Kaiyi ផ្ញើ Hewen សម្រាប់ 1v1) បាទ។

1015
00:27:12,720 --> 00:27:13,840
វាស្ទើរតែដូចជារ៉ាកែតវាយសី។

1016
00:27:13,840 --> 00:27:14,680
សាកល្បងប្រើ។

1017
00:27:14,680 --> 00:27:16,080
អ្នកណាទៅមុនគេ?

1018
00:27:16,320 --> 00:27:16,640
មក!

1019
00:27:16,640 --> 00:27:17,440
Xiaoyu ។

1020
00:27:18,120 --> 00:27:18,720
មិនអីទេ?

1021
00:27:18,720 --> 00:27:19,560
ដែល.

1022
00:27:19,560 --> 00:27:19,880
ប្រាកដ។

1023
00:27:19,880 --> 00:27:20,680
តើអ្នកចង់បានមួយណា?

1024
00:27:20,680 --> 00:27:21,920
(ក្រុម Xiaoyu ផ្ញើ Yihang សម្រាប់ 1v1) អ្នកគាំទ្រពណ៌លឿងឬរបស់អ្នក?

1025
00:27:21,920 --> 00:27:23,200
Cui ម៉េចមិនយកវាទៅ?

1026
00:27:23,200 --> 00:27:24,900
(យកវា) ឥឡូវនេះខ្ញុំស្ទើរតែមានអារម្មណ៍មិនល្អ។

1027
00:27:25,240 --> 00:27:26,640
ខ្ញុំពិតជាមានអារម្មណ៍មិនល្អចំពោះរឿងនេះ។

1028
00:27:27,960 --> 00:27:29,120
នេះគ្រាន់តែមានអារម្មណ៍ថាអយុត្តិធម៌ណាស់។

1029
00:27:29,120 --> 00:27:30,940
(មើលគាត់)

1030
00:27:31,480 --> 00:27:32,360
មើលរបស់គាត់...

1031
00:27:32,800 --> 00:27:33,720
តើយើងបានឈ្នះហើយឬនៅ?

1032
00:27:34,080 --> 00:27:35,400
អ្នកត្រូវតែឈ្នះជាមួយវា។

1033
00:27:35,400 --> 00:27:36,240
ចូរយើងជ្រើសរើសផ្នែកនោះ។

1034
00:27:36,240 --> 00:27:38,280
(ជ្រើសរើសផ្នែកសំណាងផងដែរ) អ្នកនឹងឈ្នះ, Cui ។

1035
00:27:38,280 --> 00:27:39,360
យើងនឹងយកផ្នែកនោះ។

1036
00:27:39,360 --> 00:27:40,080
ខ្យល់គឺជាការពេញចិត្តរបស់យើងនៅទីនេះ។

1037
00:27:40,080 --> 00:27:41,360
រង់ចាំ អ្នកឈ្នះត្រូវជ្រើសរើស។

1038
00:27:41,360 --> 00:27:42,720
ទៅទៀត។

1039
00:27:42,720 --> 00:27:44,040
(រាល់អត្ថប្រយោជន៍ត្រូវបានដោះសោ) យើងត្រូវតែឈ្នះ Cui ។

1040
00:27:44,040 --> 00:27:44,920
នេះ...

1041
00:27:44,920 --> 00:27:45,920
យើងជឿជាក់លើអ្នក។

1042
00:27:45,920 --> 00:27:47,120
បើ​ខ្ញុំ​នៅ​តែ​ចាញ់​គេ​ទៀត ខ្ញុំ​នឹង​ខ្មាស​គេ​ណាស់។

1043
00:27:47,120 --> 00:27:48,600
អ្នកអាចធ្វើវាបាន។ យើងជឿជាក់លើអ្នក។

1044
00:27:49,120 --> 00:27:49,840
ប្រាំពីរពិន្ទុ។

1045
00:27:49,840 --> 00:27:51,060
(ដំបូង​ដល់​ប្រាំពីរ​ពិន្ទុ​ឈ្នះ) Seven.

1046
00:27:51,680 --> 00:27:52,660
(Hewen vs. Yihang) តោះចាប់ផ្តើម។

1047
00:27:52,680 --> 00:27:53,520
តើយើងចាប់ផ្តើមទេ?

1048
00:27:53,520 --> 00:27:54,000
យើងកំពុងចាប់ផ្តើម។

1049
00:27:54,000 --> 00:27:54,310
មិនអីទេ។

1050
00:28:01,080 --> 00:28:01,840
ដែល.

1051
00:28:01,840 --> 00:28:02,680
ហេវេន។

1052
00:28:10,900 --> 00:28:12,140
(ត្រលប់មកវិញ)

1053
00:28:18,800 --> 00:28:19,920
ដែល.

1054
00:28:19,920 --> 00:28:20,760
ទេ

1055
00:28:20,760 --> 00:28:21,360
ឈប់ទះដៃ។

1056
00:28:21,360 --> 00:28:22,240
ខ្ញុំស្ទើរតែមានអារម្មណ៍មិនល្អ។

1057
00:28:22,240 --> 00:28:22,840
អាក្រក់ណាស់។

1058
00:28:24,240 --> 00:28:24,960
មួយទៅសូន្យ។

1059
00:28:25,280 --> 00:28:27,200
(Hewen 0:1 Yihang) អ្នកអាចប្តូររ៉ាកែតម្តងក្នុងអំឡុងពេលប្រកួត។

1060
00:28:27,360 --> 00:28:28,320
ទៅមុខ។ ប្តូរនៅពេលណាក៏បាន។

1061
00:28:28,320 --> 00:28:29,240
អ្នកក៏អាចប្តូរបានពីរដងដែរ។

1062
00:28:29,240 --> 00:28:30,040
សូម្បីតែពីរដង។

1063
00:28:32,360 --> 00:28:33,560
និយាយ​ឲ្យ​ពិត​ទៅ គាត់​ជា​មនុស្ស​កំប្លែង។

1064
00:28:35,740 --> 00:28:37,180
(បម្រើពីម្ខាងទៀត)

1065
00:28:40,260 --> 00:28:41,740
(មិន​អាច​ជម្រះ​សំណាញ់)

1066
00:28:41,780 --> 00:28:42,960
(ហេវេន 0:2 យីហាង)

1067
00:28:42,960 --> 00:28:43,760
ខ្ញុំ​កំពុង​តែ​ស្លាប់។

1068
00:28:46,240 --> 00:28:47,920
តើដៃរបស់អ្នកមិនឈឺពីការវាយវាទេ?

1069
00:28:48,800 --> 00:28:49,680
ការបម្រើមិនបានហួស។

1070
00:28:50,320 --> 00:28:51,040
ពីរទៅសូន្យ។

1071
00:28:52,360 --> 00:28:52,960
បម្រើម្តងទៀត។

1072
00:28:53,240 --> 00:28:53,920
ខ្ញុំនឹងអោយវាបម្រើមួយទៀត។

1073
00:28:53,920 --> 00:28:54,640
ខ្ញុំនៅតែស៊ាំនឹងវា។

1074
00:28:54,640 --> 00:28:55,400
ផ្តល់ឱ្យគាត់មួយ។

1075
00:28:55,400 --> 00:28:59,380
(ហេវិន ០:១ យីហាង)

1076
00:29:02,080 --> 00:29:02,680
មក។

1077
00:29:03,500 --> 00:29:04,380
(នៅតែប្រើដៃក្រោយ)

1078
00:29:04,720 --> 00:29:05,520
មក។

1079
00:29:05,780 --> 00:29:07,340
(មិនជម្រះសំណាញ់)

1080
00:29:07,420 --> 00:29:12,660
(ហេវេន 0:2 យីហាង)

1081
00:29:12,680 --> 00:29:13,160
ប្រាប់ពួកគេឱ្យឈប់ទះដៃ។

1082
00:29:13,160 --> 00:29:13,920
នេះ​មិន​មែន​ជា​ការ​ឈ្នះ​ដោយ​យុត្តិធម៌​ទេ។

1083
00:29:13,920 --> 00:29:14,520
ខ្ញុំចង់ប្តូរទៅកង្ហារ។

1084
00:29:14,520 --> 00:29:15,480
ខ្ញុំនឹងសាកល្បងអ្នកគាំទ្រ។

1085
00:29:15,760 --> 00:29:16,920
ប្រសិនបើអ្នកប្តូរទៅកង្ហារ

1086
00:29:16,920 --> 00:29:17,800
អ្នកប្រាកដជានឹងចាញ់។

1087
00:29:22,340 --> 00:29:23,660
(ហេវេន ១:២ យីហាង)

1088
00:29:23,680 --> 00:29:25,600
មួយទៅពីរ។

1089
00:29:26,880 --> 00:29:27,680
ដែល.

1090
00:29:29,160 --> 00:29:30,280
Cui កុំ​ទៅ​ងាយ​គាត់។

1091
00:29:30,280 --> 00:29:31,160
មក។

1092
00:29:34,580 --> 00:29:35,500
(ហេវេន ២:២ យីហាង)

1093
00:29:35,520 --> 00:29:36,080
ពីរទៅពីរ។

1094
00:29:36,320 --> 00:29:37,120
ពីរទៅពីរ។

1095
00:29:37,120 --> 00:29:38,480
អ្នកមានរ៉ាកែតវាយសី Cui ។

1096
00:29:39,500 --> 00:29:40,980
(ទទួល​បាន​ការ​ព្យួរ​វា​)

1097
00:29:42,340 --> 00:29:44,900
(ហេវេន ៣:២ យីហាង)

1098
00:29:44,920 --> 00:29:46,280
Cui អ្នកអនុញ្ញាតឱ្យគាត់ឈ្នះ។

1099
00:29:46,280 --> 00:29:47,400
ខ្ញុំមិនអាចធ្វើបែបនេះបានទេ។

1100
00:29:48,680 --> 00:29:49,880
មក។

1101
00:29:49,900 --> 00:29:50,580
(ការប៉ះថ្នមៗ)

1102
00:29:51,580 --> 00:29:57,260
(ហេវេន ៤:២ យីហាង)

1103
00:29:57,280 --> 00:29:58,800
Cui, តើធ្វើដូចម្តេចអំពីការផ្លាស់ប្តូរទៅ spatula មួយ?

1104
00:29:58,800 --> 00:29:59,080
ទេ

1105
00:29:59,600 --> 00:30:00,120
នេះល្អណាស់។

1106
00:30:01,920 --> 00:30:02,800
តើពិន្ទុអ្វី?

1107
00:30:02,800 --> 00:30:03,880
បួនទៅពីរ។

1108
00:30:05,520 --> 00:30:06,550
ខ្ញុំ​នឹង​គាំទ្រ​វា​ភ្លាមៗ​ចំពោះ​អ្នក។

1109
00:30:10,320 --> 00:30:11,400
មក។

1110
00:30:12,760 --> 00:30:13,360
នៅទីនេះវាមក។

1111
00:30:18,220 --> 00:30:22,340
(ហេវេន ៤:៣ យីហាង)

1112
00:30:22,340 --> 00:30:26,420
(ហេវេន ៤:៤ យីហាង)

1113
00:30:26,420 --> 00:30:27,940
(Yihang បន្ត​តាម​ទាន់)

1114
00:30:27,940 --> 00:30:31,900
(ហេវេន ៤:៥ យីហាង)

1115
00:30:31,900 --> 00:30:34,140
(ហេវេន ៥:៥ យីហាង)

1116
00:30:34,940 --> 00:30:38,260
(ហេវេន ៦:៥ យីហាង)

1117
00:30:38,280 --> 00:30:39,000
មួយចំណុចទៀត។

1118
00:30:39,000 --> 00:30:40,040
វា​ជា​ចំណុច​ប្រកួត​ប្រុសៗ។

1119
00:30:40,240 --> 00:30:41,120
តើអ្នកចង់បម្រើខាងណា?

1120
00:30:42,500 --> 00:30:44,580
(រ៉ាកែតវាយសី)

1121
00:30:44,580 --> 00:30:47,420
(ទល់នឹងអ្នកគាំទ្រកីឡាវាយសី។ អ្នកណានឹងឈ្នះ?)

1122
00:30:47,560 --> 00:30:48,600
ខ្ញុំ​ភ័យ​ណាស់​។

1123
00:31:02,820 --> 00:31:04,700
(ការប៉ះថ្នមៗ)

1124
00:31:10,640 --> 00:31:11,160
គាត់បានឈ្នះ។

1125
00:31:13,760 --> 00:31:14,560
ជាមួយអ្នកគាំទ្រ។

1126
00:31:15,560 --> 00:31:17,920
នោះពិតជាអស្ចារ្យណាស់។

1127
00:31:19,240 --> 00:31:20,440
គាត់បានឈ្នះ។

1128
00:31:21,060 --> 00:31:22,640
(សេចក្តីត្រេកអររបស់បុគ្គលម្នាក់ ជាសេចក្តីទុក្ខរបស់បុគ្គលដទៃ)

1129
00:31:22,640 --> 00:31:24,240
រ៉ាកែតវាយសីចាញ់អ្នកគាំទ្រ។

1130
00:31:24,400 --> 00:31:25,240
ធុញទ្រាន់?

1131
00:31:25,240 --> 00:31:25,840
មិនពិតទេ។

1132
00:31:26,720 --> 00:31:27,640
តើអ្នកបានទៅរកគាត់ដោយស្រួលទេ?

1133
00:31:27,640 --> 00:31:28,720
គាត់បានរក្សាតម្លៃនៃមហាសមុទ្រប៉ាស៊ីហ្វិកទាំងមូល។

1134
00:31:28,720 --> 00:31:29,980
(មហាសមុទ្រប៉ាស៊ីហ្វិក) ទេ ខ្ញុំមិនបានធ្វើទេ។

1135
00:31:33,440 --> 00:31:35,360
អ្នកមិនអាចប្រើរ៉ាកែតវាយសីឡើងវិញបានទេ។

1136
00:31:35,360 --> 00:31:37,480
(រ៉ាកែតវាយសីមួយពេលនេះអស់ដែនកំណត់) គ្មានរ៉ាកែតប្រើឡើងវិញទេ។

1137
00:31:37,640 --> 00:31:38,920
យើងនៅតែមានរ៉ាកែតមួយទៀត។

1138
00:31:38,920 --> 00:31:40,660
យើងមានពីរ។

1139
00:31:40,660 --> 00:31:41,880
(នៅសល់មួយទៀត) យើងមានពីរ។

1140
00:31:42,840 --> 00:31:43,520
នៅពេលដែលអ្នកបានប្រើមួយ,

1141
00:31:43,520 --> 00:31:44,520
អ្នកអាចប្រើផ្សេងទៀត។

1142
00:31:44,520 --> 00:31:45,960
អ្នកគ្រាន់តែមិនអាចប្រើពួកវាឡើងវិញបានទេ។

1143
00:31:46,200 --> 00:31:48,680
ប្រសិនបើយើងឈ្នះ 2 ទល់នឹង 2

1144
00:31:48,680 --> 00:31:49,660
យើងអាចរំលងបីទល់នឹងបី។

1145
00:31:49,660 --> 00:31:50,700
(រំលងជុំទីបី)

1146
00:31:50,720 --> 00:31:51,120
បាទ។

1147
00:31:51,120 --> 00:31:51,720
មែនទេ?

1148
00:31:51,720 --> 00:31:52,480
យើងទាំងបីមិនអាចលេងបានទេ។

1149
00:31:52,480 --> 00:31:52,960
តើអ្នកអាចពីរនាក់បានទេ?

1150
00:31:52,960 --> 00:31:53,800
បន្ទាប់មកអ្នកទាំងពីរទៅ។

1151
00:31:53,800 --> 00:31:54,920
ខ្ញុំអាចលេងបាន។

1152
00:31:55,080 --> 00:31:56,400
តោះធ្វើវា។

1153
00:32:00,540 --> 00:32:01,020
(ដុង)

1154
00:32:03,160 --> 00:32:03,560
ល្អណាស់។

1155
00:32:03,560 --> 00:32:04,440
ការបាញ់ប្រហារទាំងពីរនោះ។

1156
00:32:04,440 --> 00:32:05,360
ធានា​បាន​ច្រើន​ណាស់​ការ​ឈ្នះ​របស់​យើង​។

1157
00:32:05,360 --> 00:32:06,320
ពិតប្រាកដ។

1158
00:32:06,320 --> 00:32:06,940
(បូអ៊ីង)

1159
00:32:09,520 --> 00:32:10,680
ល្អណាស់។

1160
00:32:10,800 --> 00:32:11,760
គ្រប់គ្រាន់ហើយ។

1161
00:32:11,760 --> 00:32:13,080
នោះហើយជាអ្វីដែលយើងត្រូវការ។

1162
00:32:13,200 --> 00:32:13,960
មិនអីទេ។

1163
00:32:13,960 --> 00:32:14,520
តើ​នោះ​និយាយ​អ្វី?

1164
00:32:14,520 --> 00:32:16,860
ដាវដ៏អស្ចារ្យមិនត្រូវការគែមទេ។ ជំនាញពិតមិនត្រូវការល្បិចទេ។

1165
00:32:16,880 --> 00:32:18,040
យើងមានកវីនៅទីនេះ។

1166
00:32:18,360 --> 00:32:20,040
គាត់គឺជា Sun Zhimo របស់ Signal House ។

1167
00:32:20,040 --> 00:32:21,000
អ្នកប្រាជ្ញ។

1168
00:32:21,860 --> 00:32:22,500
(អីយ៉ា)

1169
00:32:25,400 --> 00:32:26,360
មើលថាតើពួកគេតស៊ូប៉ុណ្ណា។

1170
00:32:26,360 --> 00:32:27,180
(អត្ថាធិប្បាយព្រៃផ្សៃ)

1171
00:32:29,560 --> 00:32:30,760
មើលថាតើពួកគេតស៊ូប៉ុណ្ណា។

1172
00:32:30,760 --> 00:32:32,040
(យកពួកវាចុះ) តើយើងត្រូវបំផ្លាញពួកគេទេ?

1173
00:32:32,200 --> 00:32:32,960
បំផ្លាញពួកគេ។

1174
00:32:32,960 --> 00:32:34,400
ប៉ុន្តែ​យើង​ស្ថិត​ក្នុង​កន្លែង​ដ៏​លំបាក​មួយ​ឥឡូវ​នេះ។

1175
00:32:34,400 --> 00:32:36,560
យើងត្រូវតែឈ្នះក្នុងជុំនេះ។

1176
00:32:36,680 --> 00:32:37,920
យើងប្រាកដជានឹងឈ្នះ។ កុំបារម្ភ។

1177
00:32:38,080 --> 00:32:38,880
បន្ទាប់មកយើង...

1178
00:32:38,880 --> 00:32:41,400
យើងទាំងបីនាក់អាចប្រើប្រាស់បានតែជុំបន្ទាប់ប៉ុណ្ណោះ។

1179
00:32:41,400 --> 00:32:42,360
(សល់តែពីរអាង)

1180
00:32:42,360 --> 00:32:42,880
នេះ...

1181
00:32:42,880 --> 00:32:44,040
ប៉ុន្តែ​បើ​យើង​ឈ្នះ​ជុំ​នេះ

1182
00:32:44,040 --> 00:32:44,960
យើងនឹងមិនត្រូវការពួកគេ។

1183
00:32:45,080 --> 00:32:45,880
យើងត្រូវតែឈ្នះ។

1184
00:32:45,880 --> 00:32:46,480
យើងពិតជាធ្វើ។

1185
00:32:46,480 --> 00:32:47,440
ធ្ងន់ធ្ងរ។

1186
00:32:47,440 --> 00:32:48,280
បើយើងចាញ់ជុំនេះ

1187
00:32:48,280 --> 00:32:49,640
នេះ​ជា​អ្វី​ដែល​យើង​នឹង​នៅ​សល់។

1188
00:32:50,840 --> 00:32:51,600
តោះទៅ។

1189
00:32:51,600 --> 00:32:52,120
មក។

1190
00:32:52,120 --> 00:32:52,560
តោះទៅ។

1191
00:32:52,840 --> 00:32:53,200
មក។

1192
00:32:53,440 --> 00:32:55,000
កុំនិយាយថាយើងធ្វើបាបអ្នកនៅពេលយើងឈ្នះ។

1193
00:32:55,640 --> 00:32:56,680
យើងបានបញ្ចប់ការងាយស្រួលសម្រាប់អ្នក។

1194
00:32:56,680 --> 00:32:57,120
មិនអីទេ។

1195
00:32:57,640 --> 00:32:58,280
នាំវាមក។

1196
00:32:58,480 --> 00:32:59,480
នោះ​ជា​ការ​អះអាង​យ៉ាង​ក្លាហាន។

1197
00:32:59,480 --> 00:33:00,560
អ្នកទទួលបាននេះ។

1198
00:33:01,320 --> 00:33:01,920
តោះទៅ។

1199
00:33:01,920 --> 00:33:02,820
(Bohan & Yiheng vs. Yue'er & Xiaoyu)

1200
00:33:07,020 --> 00:33:08,340
(មហាអំណាច Spatula)

1201
00:33:11,220 --> 00:33:13,260
(ទាំងពីរទៅបាញ់)

1202
00:33:13,300 --> 00:33:14,440
(Bohan & Yiheng 1:0 Yue'er & Xiaoyu)

1203
00:33:14,440 --> 00:33:15,240
មួយទៅសូន្យ។

1204
00:33:17,440 --> 00:33:18,320
(នោះជាជំនាញពិត) ដាវដ៏អស្ចារ្យមិនត្រូវការគែមទេ។

1205
00:33:18,320 --> 00:33:19,200
ជំនាញពិតមិនត្រូវការល្បិចទេ។

1206
00:33:21,000 --> 00:33:22,080
យើង​ទាំង​ពីរ​មិន​អាច​ទៅ​រក​យាន​យន្ត​បាន​ទេ។

1207
00:33:22,280 --> 00:33:22,800
វាមិនអីទេ។

1208
00:33:22,800 --> 00:33:23,640
សូន្យទៅមួយ។

1209
00:33:24,280 --> 00:33:24,960
យើងនឹងផ្តល់ឱ្យពួកគេមួយ។

1210
00:33:24,960 --> 00:33:25,440
ផ្តល់ឱ្យពួកគេមួយ។

1211
00:33:25,440 --> 00:33:26,480
យើងនឹងអនុញ្ញាតឱ្យអ្នកមានជុំនេះ។

1212
00:33:26,480 --> 00:33:26,920
វាមិនអីទេ។

1213
00:33:27,240 --> 00:33:28,500
(លើកទឹកចិត្តនាង) មិនអីទេ។

1214
00:33:28,520 --> 00:33:29,520
កុំភ័យ។

1215
00:33:29,520 --> 00:33:30,040
វាមិនអីទេ។

1216
00:33:35,580 --> 00:33:39,820
(Bohan & Yiheng 1:1 Yue'er & Xiaoyu)

1217
00:33:39,840 --> 00:33:40,480
តើ​វា​បាន​ឆ្លង​ផុត​ហើយ​ឬ​នៅ?

1218
00:33:40,480 --> 00:33:41,480
វាជម្រះសំណាញ់ហើយមែនទេ?

1219
00:33:41,480 --> 00:33:42,800
បាទ ប៉ុន្តែអ្នកអាចឈរជិតដើម្បីប្រគល់វាមកវិញ។

1220
00:33:50,660 --> 00:33:51,420
(ការរក្សាទុកវិនាទីចុងក្រោយ)

1221
00:33:55,220 --> 00:34:02,900
(Bohan & Yiheng 1:2 Yue'er & Xiaoyu)

1222
00:34:05,340 --> 00:34:06,040
(Bohan & Yiheng 1:3 Yue'er & Xiaoyu)

1223
00:34:06,040 --> 00:34:06,600
(នឹកម្តងទៀត) បាញ់ល្អណាស់។

1224
00:34:06,600 --> 00:34:07,440
យើងបានឈ្នះ។

1225
00:34:09,120 --> 00:34:10,520
តើយើងធ្វើអ្វីឥឡូវនេះ?

1226
00:34:12,380 --> 00:34:13,100
(ងាយស្រួលត្រឡប់មកវិញ)

1227
00:34:13,120 --> 00:34:13,680
បាញ់ល្អណាស់។

1228
00:34:17,020 --> 00:34:17,660
(ដីល្អឥតខ្ចោះ)

1229
00:34:17,660 --> 00:34:19,560
(Bohan & Yiheng 1:4 Yue'er & Xiaoyu)

1230
00:34:19,560 --> 00:34:20,280
វាគឺបួនទៅមួយ។

1231
00:34:20,280 --> 00:34:21,600
បួនទៅមួយ។

1232
00:34:23,280 --> 00:34:24,000
វាបួនទល់មួយហើយ?

1233
00:34:24,440 --> 00:34:25,200
វាមិនអីទេ។

1234
00:34:25,440 --> 00:34:25,760
វាមិនអីទេ។

1235
00:34:25,960 --> 00:34:27,600
(ប្រាំនាទីមុន) កុំនិយាយថាយើងធ្វើបាបអ្នកពេលយើងឈ្នះ។

1236
00:34:32,120 --> 00:34:33,960
ខ្ញុំមិនចាំបាច់នៅទីនេះទេ។

1237
00:34:34,200 --> 00:34:35,320
យើងបានបញ្ចប់ការងាយស្រួលសម្រាប់អ្នក។

1238
00:34:37,200 --> 00:34:37,840
អ្នកបម្រើឬខ្ញុំ?

1239
00:34:37,840 --> 00:34:38,880
ខ្ញុំនឹងធ្វើវា។

1240
00:34:41,620 --> 00:34:44,660
(ទីបំផុត យីហេង អាច​បំបែក​ការ​ចាញ់​បាន​ទេ?)

1241
00:34:48,100 --> 00:34:48,940
(ត្រឡប់មកវិញមួយទៀត)

1242
00:34:52,180 --> 00:34:53,580
(Bohan & Yiheng 1:5 Yue'er & Xiaoyu)

1243
00:34:53,600 --> 00:34:54,560
វាប្រាំមួយទៅមួយ។

1244
00:34:54,980 --> 00:34:55,800
(ខ្មាស់គេពេកមិនហ៊ានប្រឈមមុខ)

1245
00:34:55,800 --> 00:34:56,960
តើយើងធ្វើអ្វី?

1246
00:34:59,760 --> 00:35:00,960
ខ្ញុំមិនចាំបាច់លេងទេ។

1247
00:35:00,960 --> 00:35:01,760
ខ្ញុំមិនចាំបាច់លេងទេ។

1248
00:35:01,760 --> 00:35:02,840
មួយទល់នឹងពីរ។

1249
00:35:07,460 --> 00:35:09,740
(ទាញចេញពីការទាត់របស់ពួកឧទ្ទាម) "The Rebel Kick" ។

1250
00:35:09,780 --> 00:35:11,520
(Bohan & Yiheng 1:6 Yue'er & Xiaoyu)

1251
00:35:11,520 --> 00:35:12,120
អាក្រក់របស់ខ្ញុំ។

1252
00:35:12,120 --> 00:35:13,320
ខ្ញុំមិនងាយនឹងអ្នកទេ បូហាន។

1253
00:35:13,320 --> 00:35:14,600
ខ្ញុំស្ទើរតែឈានជើងចូលទៅក្នុងប្រឡាយ។

1254
00:35:14,720 --> 00:35:15,680
ចូលទៅក្នុងប្រឡាយ។

1255
00:35:17,840 --> 00:35:18,760
ចំណុចចុងក្រោយ។

1256
00:35:21,040 --> 00:35:21,840
មក Xiaoyu ។

1257
00:35:28,240 --> 00:35:29,040
យើងបានឈ្នះ។

1258
00:35:32,080 --> 00:35:32,880
យើងបានធ្វើវា។

1259
00:35:33,160 --> 00:35:34,120
អរគុណអ្នកទាំងអស់គ្នា។

1260
00:35:34,720 --> 00:35:36,640
Yue'er បាន​ធ្វើ​ការ​វិល​ត្រឡប់​ទាំង​នោះ​ជាមួយ​នឹង​អ្នក​គាំទ្រ។

1261
00:35:36,640 --> 00:35:37,400
ទេ

1262
00:35:37,400 --> 00:35:39,640
(សរសើរគ្នាទៅវិញទៅមក) Xiaoyu បានត្រឡប់មកវិញដ៏អស្ចារ្យជាមួយនឹងរ៉ាកែតរបស់នាងផងដែរ។

1263
00:35:39,920 --> 00:35:41,240
មិនអាចជួយបានទេ។

1264
00:35:41,640 --> 00:35:42,960
គ្មានអ្វីដែលយើងអាចធ្វើបានឥឡូវនេះទេ។

1265
00:35:42,960 --> 00:35:43,720
យើងអស់ជម្រើសហើយ។

1266
00:35:43,720 --> 00:35:44,720
យើង​នឹង​ធ្វើ​ឱ្យ​អស់​ពី​សមត្ថភាព។

1267
00:35:45,440 --> 00:35:46,200
ធុញទ្រាន់?

1268
00:35:47,000 --> 00:35:48,480
ឆ្អឹងចាស់របស់ខ្ញុំមិនអាចយកវាបានទេ។

1269
00:35:48,480 --> 00:35:49,240
អ្នកទៅ។

1270
00:35:49,240 --> 00:35:50,040
ក្រុមបន្ទាប់។

1271
00:35:50,680 --> 00:35:51,120
ទៅមុខ។

1272
00:35:51,120 --> 00:35:51,800
មក។

1273
00:35:51,800 --> 00:35:53,900
(ក្រុម Xiaoyu បញ្ជូន Yu Yang, Fang & Si សម្រាប់ 3v3)

1274
00:35:54,040 --> 00:35:55,160
បន្ទាប់មកគឺពួកយើងទាំងបី។

1275
00:35:55,160 --> 00:35:56,910
(Team Kaiyi ផ្ញើ Xing, Meng & Kaiyi សម្រាប់ 3v3) Ok តោះទៅ។

1276
00:35:56,920 --> 00:35:57,880
កុំដួល។

1277
00:35:58,440 --> 00:35:59,720
អ្នកណាថាមនុស្សស្រីមិនអាចវាយប្រុសបានទេ?

1278
00:35:59,720 --> 00:36:00,320
តោះមើល។

1279
00:36:00,320 --> 00:36:00,960
មក។

1280
00:36:01,400 --> 00:36:02,240
យើងជឿជាក់លើអ្នក។

1281
00:36:04,880 --> 00:36:05,640
ត្រៀមខ្លួនហើយឬនៅ?

1282
00:36:06,460 --> 00:36:08,540
(Xing, Meng & Kaiyi vs Fang, Yu Yang & Si)

1283
00:36:08,800 --> 00:36:10,360
Xing, ឈរនៅកណ្តាល។

1284
00:36:10,680 --> 00:36:11,040
មិនអីទេ។

1285
00:36:11,040 --> 00:36:11,960
អ្នកមានអ្នកគាំទ្រ។

1286
00:36:11,960 --> 00:36:13,480
យើងនឹងយកជ្រុងជាមួយផើងរបស់យើង។

1287
00:36:13,480 --> 00:36:14,640
(ខ្ញុំអាច អ្នកគាំទ្រ ខ្ញុំអាចធ្វើបាន)

1288
00:36:14,640 --> 00:36:15,640
កៃ​យី​ចាំ​ចាប់​ឡាន​។

1289
00:36:15,640 --> 00:36:16,480
ដរាបណាវាមិនប៉ះដី

1290
00:36:16,480 --> 00:36:17,640
យើងនឹងមិនចាញ់ឡើយ។

1291
00:36:17,840 --> 00:36:18,880
ចាប់​វា​ដាក់​ក្នុង​ឆ្នាំង​ហើយ​បោះ​វា​មក​វិញ។

1292
00:36:20,200 --> 00:36:21,160
នេះគឺគួរឱ្យរំភើប។

1293
00:36:21,240 --> 00:36:21,960
ត្រៀមខ្លួនហើយឬនៅ?

1294
00:36:21,960 --> 00:36:22,560
មិនអីទេ។

1295
00:36:24,680 --> 00:36:25,120
ទៅ។

1296
00:36:25,320 --> 00:36:25,840
ទៅ។

1297
00:36:27,500 --> 00:36:28,900
(ព្យាយាមចាប់វាជាមួយឆ្នាំង)

1298
00:36:31,780 --> 00:36:33,180
(មិនជម្រះសំណាញ់)

1299
00:36:34,120 --> 00:36:34,880
មួយទៅសូន្យ។

1300
00:36:34,880 --> 00:36:41,020
(Xing, Meng & Kaiyi 0:1 Si, Fang & Yu Yang)

1301
00:36:41,080 --> 00:36:42,320
តើអ្នកអាចបម្រើបានទេ Kaiyi?

1302
00:36:42,320 --> 00:36:43,340
(មិនអាចបម្រើ) ខ្ញុំក៏មិនអាចដែរ។

1303
00:36:43,360 --> 00:36:44,400
Meng អាចទេ?

1304
00:36:44,400 --> 00:36:45,280
ទេ

1305
00:36:45,280 --> 00:36:45,900
(មិនអាចបម្រើ)

1306
00:36:46,180 --> 00:36:47,660
(ក្លែងក្លាយ)

1307
00:36:52,980 --> 00:36:54,540
(ទម្លាក់ត្រង់)

1308
00:36:54,560 --> 00:36:55,440
ពួកគេ។

1309
00:36:56,000 --> 00:36:56,960
ផ្តល់ឱ្យយើងនូវចំណុចឥតគិតថ្លៃ។

1310
00:36:56,960 --> 00:36:57,760
មិនបានលុបសំណាញ់ទេ។

1311
00:36:57,760 --> 00:36:59,240
(Xing, Meng & Kaiyi 0:2 Si, Fang & Yu Yang)

1312
00:36:59,240 --> 00:37:00,080
មិនបានលុបសំណាញ់ទេ។

1313
00:37:01,000 --> 00:37:01,600
នៅទីនេះវាមក។

1314
00:37:07,700 --> 00:37:08,460
(នឹក)

1315
00:37:09,660 --> 00:37:13,140
(Xing, Meng & Kaiyi 0:3 Si, Fang & Yu Yang)

1316
00:37:13,160 --> 00:37:13,800
ពីបីទៅសូន្យ។

1317
00:37:16,480 --> 00:37:17,640
ទម្រង់ដ៏ស្រស់ស្អាត។

1318
00:37:18,160 --> 00:37:19,440
យ៉ាងហោចណាស់ទម្រង់គឺស្រស់ស្អាត។

1319
00:37:21,400 --> 00:37:22,400
យើង​អាច​ដក​វា​បាន​។

1320
00:37:22,400 --> 00:37:23,740
(ហ្គេមថ្មីទាំងមូលឥឡូវនេះ) គ្រាន់តែទាញយកវាឡើង។

1321
00:37:23,760 --> 00:37:24,440
ចាប់វាដូចនេះ។

1322
00:37:24,880 --> 00:37:25,800
ស្រង់វាឡើង។

1323
00:37:26,160 --> 00:37:27,080
ចាំ...

1324
00:37:29,160 --> 00:37:30,320
ចាប់​វា​ដាក់​ក្នុង​ឆ្នាំង​ហើយ​បោះ​វា​ទៅ​វិញ។

1325
00:37:30,320 --> 00:37:32,920
រុញវាមកវិញ។

1326
00:37:32,980 --> 00:37:34,000
(បានទទួលសារ)

1327
00:37:34,000 --> 00:37:34,600
មិនអីទេ។

1328
00:37:37,300 --> 00:37:38,740
(វាយវា!)

1329
00:37:44,020 --> 00:37:44,660
(នៅតែមិនអាចជម្រះសំណាញ់)

1330
00:37:45,060 --> 00:37:50,140
(Xing, Meng & Kaiyi 0:4 Si, Fang & Yu Yang)

1331
00:37:50,160 --> 00:37:51,080
យើង​ត្រូវ​វិនាស។

1332
00:37:51,320 --> 00:37:52,520
នេះធ្ងន់ណាស់។

1333
00:37:55,560 --> 00:37:56,240
ចុះរឿងនេះ?

1334
00:37:56,520 --> 00:37:57,760
អនុញ្ញាតឱ្យពួកគេបញ្ជូន Hewen ទៅ,

1335
00:37:57,760 --> 00:37:59,200
ប៉ុន្តែគាត់ត្រូវតែប្រើ wok នោះ។

1336
00:37:59,520 --> 00:38:00,240
ប្រាកដ។

1337
00:38:00,240 --> 00:38:01,080
ចូរ​ឱ្យ​ពួក​គេ​ជា​បុរស​។

1338
00:38:01,080 --> 00:38:01,760
មើលទៅពិតជាពិបាកណាស់។

1339
00:38:01,760 --> 00:38:02,560
ធុងរបស់ពួកគេធ្ងន់ពេក។

1340
00:38:02,800 --> 00:38:03,800
ស្តាប់ទៅល្អ។

1341
00:38:04,120 --> 00:38:04,960
Hewen អ្នកក្រោកឡើង។

1342
00:38:04,960 --> 00:38:05,960
យើងអាចប្តូរកីឡាករបាន។

1343
00:38:06,240 --> 00:38:06,680
ខ្ញុំនឹងទៅ។

1344
00:38:06,680 --> 00:38:07,400
ខ្ញុំនឹងធ្វើវា។

1345
00:38:07,400 --> 00:38:08,360
ទៅចាប់យក wok នោះ។

1346
00:38:08,360 --> 00:38:09,320
វាត្រូវតែជា wok នោះ។

1347
00:38:09,320 --> 00:38:10,200
គ្មានអ្វីផ្សេងទៀតត្រូវបានអនុញ្ញាតទេ។

1348
00:38:10,400 --> 00:38:11,000
ខ្ញុំនឹងយក wok ។

1349
00:38:11,000 --> 00:38:11,520
ខ្ញុំចូល។

1350
00:38:11,520 --> 00:38:12,120
តើអ្នកណាប្តូរចេញ?

1351
00:38:12,120 --> 00:38:13,000
Hewen អ្នកក្រោកឡើង។

1352
00:38:13,000 --> 00:38:14,220
(Hewen ជំនួស Kaiyi)

1353
00:38:14,260 --> 00:38:17,660
(អ្នកឈ្នះជុំទីមួយ Hewen ត្រឡប់មកវិញ)

1354
00:38:18,160 --> 00:38:19,080
ហេតុអ្វីបានជាពួកគេប្តូរកីឡាករ?

1355
00:38:19,080 --> 00:38:20,320
មិនអីទេ។ ឱ្យគាត់លេង។

1356
00:38:21,180 --> 00:38:22,220
(Hewen ថែមទាំងឈ្នះជាមួយអ្នកគាំទ្រ)

1357
00:38:22,220 --> 00:38:23,100
(តើគាត់អាចបង្វែរអ្វីៗបានទេ?)

1358
00:38:23,280 --> 00:38:24,800
មក បម្រើ។

1359
00:38:32,620 --> 00:38:35,500
(Xing, Meng & Kaiyi 0:5 Si, Fang & Yu Yang)

1360
00:38:35,520 --> 00:38:36,120
តើអ្នកប្រើវិធីនេះដោយរបៀបណា?

1361
00:38:36,120 --> 00:38:36,960
ខ្ញុំមិនយល់ទេ។

1362
00:38:37,320 --> 00:38:39,600
ប្រហែលជាគាត់អាចលើកវាឡើង។

1363
00:38:39,800 --> 00:38:40,360
មក។

1364
00:38:42,620 --> 00:38:43,620
(លោតត្រឡប់មកវិញ)

1365
00:38:48,140 --> 00:38:49,900
(Xing, Meng & Kaiyi 0:6 Si, Fang & Yu Yang)

1366
00:38:49,920 --> 00:38:51,280
នោះរាប់។ វារាប់។

1367
00:38:51,280 --> 00:38:52,000
(មិនជម្រះសំណាញ់) ប៉ុន្តែវាមិនបានលុបសំណាញ់ទេ។

1368
00:38:52,000 --> 00:38:52,600
វារាប់។

1369
00:38:52,600 --> 00:38:53,360
វាមិនបានឆ្លងកាត់ទេ។

1370
00:38:55,080 --> 00:38:56,240
វារាប់ ប៉ុន្តែវាមិនបានជម្រះសំណាញ់ទេ។

1371
00:38:58,120 --> 00:38:59,520
អ្នកក៏អាចបោះវាដោយដៃដែរ។

1372
00:38:59,520 --> 00:39:00,400
ធ្ងន់ធ្ងរ។

1373
00:39:00,580 --> 00:39:01,500
(ទទួលបានគំនិតមួយ)

1374
00:39:02,260 --> 00:39:03,340
(ពិតជាប្រើដៃនាងមែន)

1375
00:39:09,480 --> 00:39:10,120
រង់ចាំ។

1376
00:39:10,320 --> 00:39:11,640
អ្នកនៅតែត្រូវប្រើឧបករណ៍។

1377
00:39:14,140 --> 00:39:15,060
(ចាប់ពួកគេពីការការពារ)

1378
00:39:17,640 --> 00:39:18,600
ទេ អ្នកត្រូវតែប្រើឧបករណ៍។

1379
00:39:18,600 --> 00:39:19,600
យើង​មិន​អាច​អនុញ្ញាត​វា​បាន​ទេ។

1380
00:39:19,720 --> 00:39:20,520
មិនអីទេ។

1381
00:39:25,340 --> 00:39:26,540
(Xing, Meng & Kaiyi 1:6 Si, Fang & Yu Yang)

1382
00:39:26,560 --> 00:39:27,000
បាទ។

1383
00:39:27,240 --> 00:39:28,520
Meng បង្កើតច្បាប់ទាំងអស់។

1384
00:39:31,040 --> 00:39:31,960
តើពិន្ទុអ្វី?

1385
00:39:31,960 --> 00:39:33,200
នៅសល់តែមួយចំណុច។

1386
00:39:33,200 --> 00:39:34,360
មួយចំណុចទៀត។

1387
00:39:35,360 --> 00:39:36,760
កុំតម្រង់ទៅ Hewen នៅពេលអ្នកបោះ។

1388
00:39:37,040 --> 00:39:37,920
គោលដៅនៅទីនោះ។

1389
00:39:38,880 --> 00:39:40,120
ផ្ញើទៅ Xing ។

1390
00:39:40,440 --> 00:39:41,240
ទៅ។

1391
00:39:43,700 --> 00:39:44,600
(ចាប់បានល្អណាស់)

1392
00:39:44,600 --> 00:39:45,720
អស្ចារ្យ។

1393
00:39:47,000 --> 00:39:48,320
អស្ចារ្យ។

1394
00:39:55,820 --> 00:39:57,180
(បុកពេញបណ្តាញ)

1395
00:39:59,260 --> 00:40:01,500
(ពិន្ទុចុងក្រោយ៖ ក្រុម Kaiyi 1:2 ក្រុម Xiaoyu)

1396
00:40:01,520 --> 00:40:02,640
នោះពិតជាជិតស្និទ្ធណាស់។

1397
00:40:02,640 --> 00:40:03,840
ស្ទើរតែឈ្នះ។

1398
00:40:04,400 --> 00:40:06,360
នោះ​ជា​ការ​បាញ់​ប្រហារ

1399
00:40:07,040 --> 00:40:07,560
មាន...

1400
00:40:07,560 --> 00:40:09,000
មិនមានវិធីដើម្បីលេងជាមួយនេះទេ។

1401
00:40:09,000 --> 00:40:09,520
គួរឱ្យចាប់អារម្មណ៍។

1402
00:40:09,520 --> 00:40:10,520
យើង​បាន​ធ្វើ​អស់​ពី​សមត្ថភាព។

1403
00:40:10,800 --> 00:40:11,480
យើងប្រាកដជាបានធ្វើ។

1404
00:40:12,160 --> 00:40:13,160
នោះជាការសប្បាយ។

1405
00:40:13,960 --> 00:40:14,880
មិនអីទេ នោះហើយជាវា។

1406
00:40:15,320 --> 00:40:16,160
នោះពិតជាមិនគួរឱ្យជឿ។

1407
00:40:16,360 --> 00:40:17,400
មិនអីទេ យើងចាញ់ម្តងទៀត។

1408
00:40:17,400 --> 00:40:18,480
ការដាក់ទណ្ឌកម្មរបស់យើងគឺ ...

1409
00:40:18,480 --> 00:40:19,440
ញ៉ាំក្រូចឆ្មាមែនទេ?

1410
00:40:19,440 --> 00:40:20,480
មក។ អ្នកណាចាញ់?

1411
00:40:21,440 --> 00:40:22,640
មានបីនៅទីនេះ។

1412
00:40:22,920 --> 00:40:24,360
តើអ្នកណាខ្លះចូលចិត្តក្រូចឆ្មា?

1413
00:40:24,840 --> 00:40:25,600
ខ្ញុំស្រលាញ់ពួកគេ។

1414
00:40:25,600 --> 00:40:26,240
ពិតជា?

1415
00:40:26,240 --> 00:40:26,800
ខ្ញុំធ្វើ។

1416
00:40:27,200 --> 00:40:28,200
ចូរ​ឲ្យ​អ្នក​ទាំង​បី​ញ៉ាំ​វា​ទៅ។

1417
00:40:28,440 --> 00:40:29,280
ខ្ញុំពិតជាចូលចិត្តពួកគេ។

1418
00:40:29,280 --> 00:40:30,200
ពួកគេស្រស់ស្រាយណាស់។

1419
00:40:33,160 --> 00:40:33,840
ស្រស់ស្រាយណាស់។

1420
00:40:35,960 --> 00:40:36,760
ខ្ញុំស្រលាញ់រឿងនេះ។

1421
00:40:36,760 --> 00:40:37,460
(ពិតទេ?)

1422
00:40:39,580 --> 00:40:41,540
(សាករសជាតិ)

1423
00:40:42,900 --> 00:40:44,180
(មិនអាចសូម្បីតែរសជាតិវា)

1424
00:40:45,060 --> 00:40:46,580
(ស្រួលម្ល៉េះ?)

1425
00:40:51,840 --> 00:40:52,640
ជូរ?

1426
00:40:54,440 --> 00:40:55,040
វាធ្វើឱ្យខ្ញុំស្រក់ទឹកមាត់។

1427
00:40:55,560 --> 00:40:56,240
ស្រស់ស្រាយ?

1428
00:41:02,080 --> 00:41:03,920
តោះទៅញ៉ាំ។

1429
00:41:04,600 --> 00:41:05,800
តាំងពីយើងចាញ់...

1430
00:41:05,800 --> 00:41:06,760
ក្រុមរបស់យើងចាញ់។

1431
00:41:06,760 --> 00:41:07,880
ដូច្នេះយើងនឹង

1432
00:41:07,880 --> 00:41:09,240
ធ្វើម្ហូបឱ្យអ្នករាល់គ្នា។

1433
00:41:09,240 --> 00:41:10,520
គ្រាន់តែប្រាប់យើងពីអ្វីដែលអ្នកចង់បាន។

1434
00:41:12,280 --> 00:41:12,720
មិនអីទេ។

1435
00:41:13,040 --> 00:41:14,600
អ្នកដែលចង់ធ្វើម្ហូបអាចចូលរួមជាមួយយើង។

1436
00:41:14,840 --> 00:41:15,680
តោះបញ្ជាទិញ។

1437
00:41:15,800 --> 00:41:16,440
តោះបញ្ជាទិញ។

1438
00:41:16,440 --> 00:41:17,400
ព្រះពុទ្ធ​លោត​លើ​ជញ្ជាំង​យ៉ាង​ម៉េច​ដែរ?

1439
00:41:19,160 --> 00:41:19,880
អ្នកអាចបញ្ជាទិញអ្វីក៏ដោយ

1440
00:41:19,880 --> 00:41:20,920
ប៉ុន្តែយើងប្រហែលជាមិនអាចធ្វើវាបានទេ។

1441
00:41:21,720 --> 00:41:22,200
កុំរុញយើង។

1442
00:41:22,200 --> 00:41:23,160
យើងទាំងអស់គ្នានឹងលោតពីលើជញ្ជាំង។

1443
00:41:23,160 --> 00:41:24,160
(បង្ហាញការលោតជញ្ជាំង) ហើយចេញពីទីនេះ។

1444
00:41:24,160 --> 00:41:24,840
ខ្ញុំកំពុងប្រាប់អ្នក។

1445
00:41:25,160 --> 00:41:26,160
បន្ទាប់មកប្រឡាក់ស៊ុតជាមួយប៉េងប៉ោះ។

1446
00:41:26,160 --> 00:41:26,920
ពងមាន់ជាមួយប៉េងប៉ោះ? ប្រាកដ។

1447
00:41:27,240 --> 00:41:27,880
សាច់ជ្រូកឆ្អិនពីរដង។

1448
00:41:27,880 --> 00:41:28,480
យើងមានសាច់ជ្រូក។

1449
00:41:28,480 --> 00:41:29,000
បង្គា។

1450
00:41:29,000 --> 00:41:31,080
តោះធ្វើម្ហូបបង្គាមួយប្រភេទ។

1451
00:41:31,080 --> 00:41:31,520
មិនអីទេ។

1452
00:41:31,520 --> 00:41:32,440
យើងបានទិញបង្គាច្រើន។

1453
00:41:32,440 --> 00:41:34,200
មាន់ជល់។

1454
00:41:34,200 --> 00:41:34,440
មិនអីទេ។

1455
00:41:34,440 --> 00:41:35,360
នំប៉ាវ។

1456
00:41:35,360 --> 00:41:36,160
តើអ្នកចង់បាននំប៉ាវទេ?

1457
00:41:36,600 --> 00:41:37,040
នំប៉ាវ។

1458
00:41:37,040 --> 00:41:37,960
មិនអីទេ យើងនឹងព្យាយាម។

1459
00:41:37,960 --> 00:41:38,440
គ្រប់គ្រាន់ហើយ។

1460
00:41:38,440 --> 00:41:38,760
មិនអីទេ។

1461
00:41:38,760 --> 00:41:39,320
នោះហើយជាអ្វីគ្រប់យ៉ាងមែនទេ?

1462
00:41:39,320 --> 00:41:39,880
មិនអីទេ។

1463
00:41:39,880 --> 00:41:40,440
តោះទៅ។

1464
00:41:40,440 --> 00:41:41,640
ចូរយើងទទួលបានគ្រឿងផ្សំ។

1465
00:41:41,800 --> 00:41:42,480
មិនអីទេ។

1466
00:41:42,480 --> 00:41:43,720
តោះទៅ។

1467
00:41:50,080 --> 00:41:51,720
មានបន្លែជាច្រើននៅទីនោះ។

1468
00:41:52,080 --> 00:41:52,880
បាទ។

1469
00:41:53,440 --> 00:41:55,080
យើងបាននាំយកអាហារយ៉ាងច្រើន។

1470
00:41:55,080 --> 00:41:56,200
ច្រើនណាស់។

1471
00:41:56,200 --> 00:41:57,680
ម្ទេសប្លោក ការ៉ុត...

1472
00:41:58,320 --> 00:41:59,360
ការ៉ុត។

1473
00:41:59,450 --> 00:42:00,240
អីយ៉ា។

1474
00:42:00,880 --> 00:42:01,880
ខ្ញុំពិតជាចង់ចំអិន។

1475
00:42:01,880 --> 00:42:02,680
តើនេះជាអ្វី?

1476
00:42:02,680 --> 00:42:04,280
វាជាផ្លែឈើដែល Fang នាំយកមក។

1477
00:42:04,280 --> 00:42:05,040
ញ៉ាំខ្លះ។

1478
00:42:05,040 --> 00:42:05,520
ទៅមុខ។

1479
00:42:05,520 --> 00:42:06,520
យើងអាចញ៉ាំអាហារពេលកំពុងចម្អិនអាហារ។

1480
00:42:07,560 --> 00:42:08,400
អ្នកត្រូវតែត្រជាក់។

1481
00:42:08,400 --> 00:42:09,200
តាមពិតខ្ញុំក្តៅបន្តិច។

1482
00:42:09,480 --> 00:42:10,360
ខ្ញុំមិនត្រជាក់ទេ។

1483
00:42:10,360 --> 00:42:11,160
ដាក់វានៅលើ។

1484
00:42:14,820 --> 00:42:15,900
(មើលទៅក្រោយ)

1485
00:42:16,320 --> 00:42:17,320
តើអាវរបស់អ្នកនៅឯណា?

1486
00:42:17,320 --> 00:42:18,240
នៅទីនេះ។

1487
00:42:18,240 --> 00:42:19,160
កន្លែងណា?

1488
00:42:19,160 --> 00:42:19,800
(កាន់វា)

1489
00:42:19,800 --> 00:42:20,800
អូ នៅទីនោះ។

1490
00:42:21,160 --> 00:42:21,960
តោះចម្អិនអាហារ។

1491
00:42:22,520 --> 00:42:23,640
តោះចម្អិនអាហារ។

1492
00:42:24,160 --> 00:42:25,480
អ្នកគ្រាន់តែអាចសម្រាកបាន។

1493
00:42:25,480 --> 00:42:27,280
ជាការពិតណាស់យើងនឹងជួយ។

1494
00:42:28,160 --> 00:42:28,680
ប្រាកដ។

1495
00:42:28,680 --> 00:42:30,440
ត្រូវការជំនួយទេ?

1496
00:42:30,440 --> 00:42:31,440
តើអ្នកណាកំពុងធ្វើម្ហូប?

1497
00:42:31,960 --> 00:42:32,680
Cao Yiheng គឺ។

1498
00:42:32,680 --> 00:42:33,320
តើបង្គារបស់អ្នកនៅឯណា?

1499
00:42:33,320 --> 00:42:34,040
តើគាត់កំពុងធ្វើអ្វី?

1500
00:42:34,040 --> 00:42:35,180
(យីហេងកំពុងធ្វើបង្គា) He's making shrimp.

1501
00:42:35,280 --> 00:42:36,480
តើអ្នកនឹងធ្វើអ្វី?

1502
00:42:37,040 --> 00:42:37,600
អ្វីៗមិនអីទេ។

1503
00:42:37,600 --> 00:42:38,720
ខ្ញុំបានឃើញឆ្អឹងជំនីរនៅទីនោះ។

1504
00:42:38,720 --> 00:42:39,920
ប្រហែលជាខ្ញុំនឹងធ្វើឆ្អឹងជំនីរខ្លះ។

1505
00:42:39,920 --> 00:42:40,340
(Xiaoyu កំពុង​ធ្វើ​ឆ្អឹងជំនីរ)

1506
00:42:40,640 --> 00:42:41,280
មួយកន្លែង។

1507
00:42:41,280 --> 00:42:42,440
តើ Bohan នឹងប្រើមួយណា?

1508
00:42:42,440 --> 00:42:43,080
ខ្ញុំ?

1509
00:42:43,080 --> 00:42:43,920
អ្នកជ្រើសរើសដំបូង។

1510
00:42:43,920 --> 00:42:44,680
ធ្វើឱ្យចុងក្រោយរបស់អ្នក។

1511
00:42:44,680 --> 00:42:45,800
វានឹងត្រជាក់ប្រសិនបើអ្នកចំអិនវាលឿនពេក។

1512
00:42:45,800 --> 00:42:47,200
បាទ, របស់អ្នកត្រជាក់ចុះយ៉ាងលឿន។

1513
00:42:47,200 --> 00:42:47,920
ហើយវាឆ្អិនលឿន។

1514
00:42:48,360 --> 00:42:49,520
Yue'er កំពុង​ធ្វើ​អ្វី?

1515
00:42:49,520 --> 00:42:50,680
ខ្ញុំអាចស្ងោរនំប៉ាវ។

1516
00:42:50,780 --> 00:42:51,560
(Yue'er កំពុងដាំនំប៉ាវ)

1517
00:42:51,560 --> 00:42:52,440
មិនអីទេ។

1518
00:42:52,440 --> 00:42:53,080
សាច់ជ្រូកឆ្អិនពីរដង។

1519
00:42:53,080 --> 00:42:54,540
(Yu Yang កំពុងធ្វើសាច់ជ្រូកឆ្អិនពីរដង) កូនធ្វើបែបហ្នឹង

1520
00:42:54,640 --> 00:42:55,520
ខ្ញុំនឹងបកសំបកទាំងនេះសម្រាប់អ្នក។

1521
00:42:55,520 --> 00:42:56,420
(ជួយបកបង្គា)

1522
00:42:56,560 --> 00:42:57,640
មើលម្រាមដៃរបស់អ្នក។

1523
00:42:57,640 --> 00:42:58,000
មិនអីទេ។

1524
00:42:59,180 --> 00:42:59,720
(ក្រឡេកមើល)

1525
00:42:59,720 --> 00:43:00,880
កុំវាយខ្លួនឯង។

1526
00:43:03,240 --> 00:43:04,440
តើអ្នកកំពុងធ្វើអ្វី Hewen?

1527
00:43:04,440 --> 00:43:05,960
ខ្ញុំកំពុងជួយ Yihang កាត់បន្លែ។

1528
00:43:06,860 --> 00:43:08,940
(ជួយរៀបចំគ្រឿងផ្សំ)

1529
00:43:09,400 --> 00:43:10,320
សម្រាប់នំប៉ាវ,

1530
00:43:10,320 --> 00:43:11,960
តើខ្ញុំគួរចំអិនមួយចានឬទាំងពីរ?

1531
00:43:12,480 --> 00:43:14,000
ចម្អិនវាទាំងអស់ប្រសិនបើពួកគេសមនឹង។

1532
00:43:14,000 --> 00:43:15,040
មិនអីទេ។

1533
00:43:15,040 --> 00:43:16,160
នំប៉ាវពីរដុំនីមួយៗ។

1534
00:43:16,160 --> 00:43:16,680
បាទ។

1535
00:43:16,680 --> 00:43:17,960
មិនអីទេ តោះធ្វើម្ហូប។

1536
00:43:19,740 --> 00:43:21,500
(ចាប់​ផ្តើម​ពី​គ្រឿង​បំពង​បំពង)

1537
00:43:22,620 --> 00:43:24,980
(បន្ថែមគ្រឿងទេស និង ឆា)

1538
00:43:25,740 --> 00:43:29,060
(Yihang ចាប់ផ្តើមធ្វើមាន់គុយរី)

1539
00:43:31,280 --> 00:43:32,400
ខ្ញុំនឹងកាន់វាសម្រាប់អ្នក។

1540
00:43:32,400 --> 00:43:33,720
(កាន់វាសម្រាប់នាង) សូមអរគុណ។

1541
00:43:33,740 --> 00:43:35,260
(បន្ថែមនំប៉ាវ)

1542
00:43:36,400 --> 00:43:37,840
(យីហេងចាប់ផ្តើមធ្វើបង្គា) ចាប់ផ្តើមហើយមេចុងភៅ?

1543
00:43:37,840 --> 00:43:38,640
បាទ

1544
00:43:40,680 --> 00:43:42,120
ឥឡូវនេះគ្រាន់តែកូរវានៅជុំវិញ។

1545
00:43:44,600 --> 00:43:46,080
វា​ខ្លាំង​ណាស់។

1546
00:43:47,980 --> 00:43:49,980
(នំប៉ាវ មាន់​គុយទាវ បង្គា និង​ចៀន​បំពង​កំពុង​ដំណើរការ)

1547
00:43:50,340 --> 00:43:52,300
(ចាប់យកអាវផាយ)

1548
00:43:52,500 --> 00:43:54,420
(ក្រឡេកមើល)

1549
00:43:55,960 --> 00:43:57,240
នេះគឺជា apron ។

1550
00:43:57,640 --> 00:43:58,440
ខ្ញុំមិនត្រជាក់ទេ។

1551
00:43:58,680 --> 00:43:59,480
អ្នកនឹងមិនពាក់អាវផាយ?

1552
00:43:59,480 --> 00:44:00,680
អ្នកនឹងធុំក្លិនដូចអាហារ។

1553
00:44:00,680 --> 00:44:01,600
ក្នុងមួយវិនាទី។

1554
00:44:04,800 --> 00:44:06,360
អនុញ្ញាតឱ្យខ្ញុំជួយអ្នក។

1555
00:44:06,360 --> 00:44:07,520
ផ្នែកនេះទៅខាងក្រោយ។

1556
00:44:16,200 --> 00:44:18,240
ដាក់ដៃរបស់អ្នកនៅទីនេះ។

1557
00:44:21,560 --> 00:44:22,360
នៅទីនេះ។

1558
00:44:25,060 --> 00:44:26,580
(បិទមុខរបស់គាត់ទាំងស្រុង)

1559
00:44:26,920 --> 00:44:27,960
វាលាបមុខខ្ញុំ។

1560
00:44:31,440 --> 00:44:32,480
ដាក់វានៅទីនេះ។

1561
00:44:32,800 --> 00:44:33,600
បែបនេះ?

1562
00:44:35,800 --> 00:44:37,160
នោះហើយជាវា។

1563
00:44:37,160 --> 00:44:37,960
ខ្ញុំ​កំពុង​តែ​ស្លាប់។

1564
00:44:47,020 --> 00:44:48,140
(គ្រប់ទីកន្លែង)

1565
00:44:49,040 --> 00:44:50,120
ទារក វាមិនត្រូវបានចងទេ។

1566
00:44:53,720 --> 00:44:55,040
នេះគួរឱ្យអស់សំណើចណាស់។

1567
00:44:55,520 --> 00:44:56,960
តើអ្នកចងអាវផាយនេះដោយរបៀបណា?

1568
00:44:57,640 --> 00:44:58,600
នៅទីនេះ។

1569
00:44:58,600 --> 00:44:59,560
ជុំវិញខ្នង។

1570
00:45:00,160 --> 00:45:00,880
ខ្សែទាំងពីរទៅខាងក្រោយ។

1571
00:45:00,880 --> 00:45:01,640
នេះកំប្លែងពេកហើយ។

1572
00:45:02,720 --> 00:45:03,520
ដូចនេះ។

1573
00:45:06,020 --> 00:45:07,180
(ចងវាកាន់តែតឹង)

1574
00:45:07,200 --> 00:45:08,520
រួចរាល់ទាំងអស់។

1575
00:45:09,660 --> 00:45:11,220
(ដាក់បង្គាមួយឡែក)

1576
00:45:13,700 --> 00:45:14,380
(បើកកំដៅវិញ)

1577
00:45:14,460 --> 00:45:15,620
(បន្ថែមប្រេង)

1578
00:45:15,820 --> 00:45:17,620
(បន្ថែមម្ទេសស្ងួត)

1579
00:45:19,940 --> 00:45:21,420
(ជក់បារីគ្រប់ទីកន្លែង)

1580
00:45:26,640 --> 00:45:27,440
តើ​ម្ហូប​នោះ​ជា​អ្នក​ណា?

1581
00:45:29,320 --> 00:45:30,840
តើ​ទីនេះ​គ្មាន​ក្រណាត់​ជួរ​ទេ?

1582
00:45:31,260 --> 00:45:32,500
(មានក្លិនឈ្ងុយឈ្ងប់)

1583
00:45:34,120 --> 00:45:36,160
គ្រប់​គ្នា​យំ​ពី​ការ​រំកិល​ខ្លួន។

1584
00:45:36,320 --> 00:45:37,040
យីហេង

1585
00:45:37,040 --> 00:45:38,160
អ្នកកំពុងប្រើអាវុធគីមី។

1586
00:45:40,400 --> 00:45:42,240
សូមអភ័យទោស ខ្ញុំបានបន្ថែមម្ទេសច្រើនពេក។

1587
00:45:42,680 --> 00:45:44,120
វាទាំងអស់មកពី wok របស់អ្នក?

1588
00:45:44,120 --> 00:45:44,800
បាទ។

1589
00:45:45,880 --> 00:45:47,160
ហេតុអ្វីបានជាអ្នកទាំងអស់គ្នាមិនមកទីនេះ?

1590
00:45:47,640 --> 00:45:48,640
វាគួរឱ្យខ្លាចនៅទីនោះ។

1591
00:45:49,120 --> 00:45:50,760
មកទីនេះ។

1592
00:45:50,760 --> 00:45:51,720
(ការជម្លៀសជាបន្ទាន់) សូមអញ្ជើញមកជ្រកកោន។

1593
00:45:51,720 --> 00:45:52,760
យកគម្រប។

1594
00:45:53,120 --> 00:45:54,000
មកដល់។

1595
00:45:54,960 --> 00:45:55,880
វាជិតរួចរាល់ហើយ។

1596
00:45:56,920 --> 00:45:58,280
ផ្សែងហុយពេញផ្លូវនៅទីនោះ។

1597
00:45:59,140 --> 00:46:00,380
(ចៀនអោយលឿន)

1598
00:46:00,480 --> 00:46:01,360
ជិតរួចរាល់ហើយ។

1599
00:46:02,780 --> 00:46:04,380
(ប្រញាប់ធ្វើម្ហូប)

1600
00:46:04,680 --> 00:46:06,160
ខ្ញុំកំពុងលាបវា។

1601
00:46:10,340 --> 00:46:12,620
(បង្គាហឹររបស់យីហេងរួចរាល់)

1602
00:46:12,640 --> 00:46:14,160
ក្លិនដ៏អស្ចារ្យ។

1603
00:46:15,560 --> 00:46:17,720
វាមើលទៅល្អណាស់។

1604
00:46:17,720 --> 00:46:18,480
ឱ្យខ្ញុំថតរូប។

1605
00:46:19,080 --> 00:46:19,680
គួរឱ្យចាប់អារម្មណ៍។

1606
00:46:20,160 --> 00:46:21,200
អ្នកធ្វើពងទា។

1607
00:46:21,200 --> 00:46:22,000
យើងជិតរួចរាល់ហើយ។

1608
00:46:23,020 --> 00:46:25,460
(មាន់គុយរីរបស់ Yihang រួចរាល់)

1609
00:46:27,000 --> 00:46:28,600
នេះគឺពិតជាមានរសជាតិ។

1610
00:46:28,600 --> 00:46:30,140
(ប្រហិតរបស់បូហាន់រួចរាល់) មើលទៅល្អណាស់។

1611
00:46:30,860 --> 00:46:32,140
(យកនំប៉ាវចេញ)

1612
00:46:32,820 --> 00:46:34,660
(នំប៉ាវរបស់ Yue'er រួចរាល់ហើយ)

1613
00:46:34,680 --> 00:46:36,880
ជាការប្រសើរណាស់, នៅសល់គឺអាស្រ័យលើអ្នក។

1614
00:46:36,880 --> 00:46:38,000
(មេចុងភៅក្រុមទី ២ កាន់កាប់)

1615
00:46:38,000 --> 00:46:38,880
ខ្ញុំ​មិន​គិត​ថា​អ្នក​ពាក់​វា​បែប​នោះ​ទេ។

1616
00:46:38,880 --> 00:46:39,560
រង់ចាំ។

1617
00:46:42,120 --> 00:46:42,840
វាមិនអីទេ។

1618
00:46:42,840 --> 00:46:43,720
ខ្ញុំនឹងជួយអ្នក។

1619
00:46:43,720 --> 00:46:44,440
តើអ្នកដាក់នេះដោយរបៀបណា?

1620
00:46:44,440 --> 00:46:45,800
អ្នករអិលវាដូចនោះ។

1621
00:46:45,800 --> 00:46:46,600
បាទ។

1622
00:46:46,740 --> 00:46:47,780
(ក្រឡេកមើល)

1623
00:46:48,360 --> 00:46:49,160
សូមអរគុណ។

1624
00:46:49,800 --> 00:46:51,120
ដំបូងអ្នកត្រូវ ...

1625
00:46:53,000 --> 00:46:54,280
ឱ្យគាត់ដាក់ដៃទៅមុខ។

1626
00:46:54,280 --> 00:46:55,120
ដាក់វាដូចនេះ។

1627
00:46:55,120 --> 00:46:57,360
នៅទីនេះ Hewen ។ ដាក់វានៅលើ។

1628
00:46:59,200 --> 00:46:59,960
បែបនេះមែនទេ?

1629
00:46:59,960 --> 00:47:00,480
បាទ។

1630
00:47:00,480 --> 00:47:01,640
បន្ទាប់មក...

1631
00:47:01,640 --> 00:47:01,920
ទាញ។

1632
00:47:01,920 --> 00:47:03,240
យើងម្នាក់ៗនឹងជួយអ្នកដោយម្ខាង។

1633
00:47:03,240 --> 00:47:04,560
(ជួយគ្នា) ល្អណាស់។ សូមអរគុណ។

1634
00:47:04,560 --> 00:47:05,680
ពណ៌នេះពិតជាសាកសមនឹងអ្នក។

1635
00:47:06,560 --> 00:47:07,360
សូមអរគុណ។

1636
00:47:09,440 --> 00:47:10,560
យើង​បាន​ចង​អ្នក​ទាំង​អស់​គ្នា។

1637
00:47:10,560 --> 00:47:11,920
នៅទីនោះ។ ល្អឥតខ្ចោះ។

1638
00:47:11,920 --> 00:47:12,720
មិនអីទេ។

1639
00:47:15,080 --> 00:47:16,000
នោះមានអារម្មណ៍ថាត្រឹមត្រូវ។

1640
00:47:19,180 --> 00:47:20,780
(ចាប់ផ្តើមពីពងមាន់ជាមួយប៉េងប៉ោះ)

1641
00:47:20,960 --> 00:47:22,200
Yu Yang តើអ្នកកំពុងធ្វើអ្វី?

1642
00:47:22,840 --> 00:47:24,360
សាច់ជ្រូកឆ្អិនពីរដង។

1643
00:47:27,260 --> 00:47:28,980
(ដុតសាច់ជ្រូក)

1644
00:47:29,280 --> 00:47:30,400
អនុញ្ញាតឱ្យខ្ញុំថតរឿងនេះ។

1645
00:47:32,780 --> 00:47:33,380
(ទិដ្ឋភាពកាមេរ៉ារបស់ហ្វាង)

1646
00:47:33,380 --> 00:47:34,220
(បន្ថែមបន្លែ)

1647
00:47:37,280 --> 00:47:38,240
ក្លិនល្អណាស់។

1648
00:47:39,580 --> 00:47:40,380
(ចៀនឆ្អឹងជំនីរ)

1649
00:47:40,700 --> 00:47:41,460
(បន្ថែមគ្រឿងទេស)

1650
00:47:41,460 --> 00:47:42,920
(បន្ថែមទឹកជ្រលក់)

1651
00:47:42,920 --> 00:47:44,920
ខ្ញុំនឹងជួយសម្អាតធុងសំរាម។

1652
00:47:44,920 --> 00:47:45,720
មិនអីទេ។

1653
00:47:46,660 --> 00:47:48,020
(ជួយសម្អាតតុ)

1654
00:47:53,760 --> 00:47:54,680
រួចរាល់ហើយ។

1655
00:47:55,420 --> 00:47:57,540
(ស៊ុតចំបើងរបស់ Hewen ជាមួយប៉េងប៉ោះរួចរាល់)

1656
00:47:58,260 --> 00:48:00,800
(សាច់ជ្រូកឆ្អិនពីរដងរបស់ Yu Yang រួចរាល់ហើយ)

1657
00:48:00,800 --> 00:48:01,760
តោះដាក់ចាន។

1658
00:48:01,760 --> 00:48:02,560
មិនអីទេ។

1659
00:48:03,200 --> 00:48:04,000
ល្អឥតខ្ចោះ។

1660
00:48:04,000 --> 00:48:04,780
(ឆ្អឹងជំនីរផ្អែម និងជូររបស់ Xiaoyu រួចរាល់ហើយ)

1661
00:48:04,840 --> 00:48:05,960
តោះយក

1662
00:48:05,960 --> 00:48:07,640
អាហារទាំងអស់នៅទីនោះ។

1663
00:48:07,640 --> 00:48:08,040
តោះទៅ។

1664
00:48:10,440 --> 00:48:12,680
សូមស្វាគមន៍គូស្វាមីភរិយាថ្មីដំបូងរបស់យើង។

1665
00:48:12,680 --> 00:48:13,560
អ្នកតំណាងទៅមុន។

1666
00:48:15,440 --> 00:48:16,840
មកដល់ហើយ...

1667
00:48:25,480 --> 00:48:26,680
អាហារនៅទីនេះ។

1668
00:48:29,560 --> 00:48:31,040
ដូច្នេះ...

1669
00:48:31,040 --> 00:48:31,440
តើអ្នកកំពុងអង្គុយនៅឯណា?

1670
00:48:31,440 --> 00:48:32,280
យើងនឹងអង្គុយនៅទីនេះជាមួយគ្នា។

1671
00:48:32,320 --> 00:48:33,640
តើខ្ញុំអាចអង្គុយនៅទីនេះបានទេ?

1672
00:48:33,640 --> 00:48:34,320
អ្នក និង Yihang...

1673
00:48:34,320 --> 00:48:34,960
អង្គុយនៅទីនេះជាមួយយីហាង។

1674
00:48:35,480 --> 00:48:36,280
ប្រាកដ។

1675
00:48:36,640 --> 00:48:37,160
ទឹកដោះគោជូរ។

1676
00:48:37,160 --> 00:48:38,800
(ទឹកដោះគោយ៉ាអួរៀបចំសម្រាប់អ្នករាល់គ្នា) អ្នកណាខ្លះចង់បានទឹកដោះគោជូរ?

1677
00:48:39,280 --> 00:48:40,120
ខ្ញុំនឹងមានមួយ។

1678
00:48:40,120 --> 00:48:41,720
នេះនឹងក្លាយជាទីបីរបស់ខ្ញុំ។

1679
00:48:41,720 --> 00:48:42,560
សូមអរគុណ។

1680
00:48:44,400 --> 00:48:45,160
ខ្ញុំនឹងអោយវាទៅ Yu Yang ។

1681
00:48:45,160 --> 00:48:46,240
ខ្ញុំគ្រាន់តែចែករំលែករបស់គាត់។

1682
00:48:46,240 --> 00:48:47,380
(មិនមែនខ្ញុំចង់បាន)

1683
00:48:47,520 --> 00:48:48,320
Xiaoyu ។

1684
00:48:48,560 --> 00:48:49,360
សូមអរគុណ។

1685
00:48:50,680 --> 00:48:51,720
ខ្ញុំនឹងទុកពីរនៅទីនេះសម្រាប់អ្នក។

1686
00:48:51,720 --> 00:48:53,520
ខ្ញុំនឹងដាក់នៅសល់នៅទីនោះ។

1687
00:48:53,880 --> 00:48:54,640
បន្ទាប់មកខ្ញុំនឹងយកមួយទៀត។

1688
00:48:54,640 --> 00:48:55,560
Meng, មួយទៀតសម្រាប់ខ្ញុំ។

1689
00:48:55,680 --> 00:48:56,120
មិនអីទេ។

1690
00:48:56,520 --> 00:48:57,480
Yue'er ចង់បានខ្លះ?

1691
00:48:57,880 --> 00:48:58,320
បាទ។

1692
00:48:58,320 --> 00:48:59,000
សូមអរគុណ។

1693
00:48:59,000 --> 00:48:59,520
ខ្ញុំមិនត្រូវការមួយទេ។

1694
00:48:59,520 --> 00:49:00,280
ខ្ញុំល្អណាស់។

1695
00:49:00,280 --> 00:49:01,200
ផ្តល់ឱ្យពួកគេ។

1696
00:49:01,200 --> 00:49:02,000
យើងនឹងចែករំលែកមួយនេះ។

1697
00:49:02,000 --> 00:49:02,600
តើអ្នកកំពុងចែករំលែកមួយ?

1698
00:49:02,600 --> 00:49:03,520
មែនហើយ ឲ្យវាទៅពួកគេ។

1699
00:49:03,800 --> 00:49:04,720
អ្នកណាខ្លះចង់បានទឹកដោះគោជូរ?

1700
00:49:07,740 --> 00:49:08,400
(ជួយបញ្ចេញទឹកដោះគោជូរ)

1701
00:49:08,400 --> 00:49:09,480
សូមអរគុណ។

1702
00:49:09,480 --> 00:49:09,920
ទទួលបានមួយ?

1703
00:49:09,920 --> 00:49:10,880
បាទ យើងទាំងអស់គ្នាទទួលបានខ្លះ។

1704
00:49:10,880 --> 00:49:12,120
អ្នករាល់គ្នានៅទីនេះមានមួយ។

1705
00:49:12,120 --> 00:49:12,920
មិនអីទេ។

1706
00:49:15,040 --> 00:49:16,000
បិទបាំងបន្តិច។

1707
00:49:16,000 --> 00:49:16,880
អ្នកត្រូវតែត្រជាក់។

1708
00:49:16,880 --> 00:49:18,000
(មើលថែគាត់)

1709
00:49:18,000 --> 00:49:18,920
វាពិតជាសាកសមនឹងអ្នក។

1710
00:49:18,920 --> 00:49:19,960
បាទ។ តើនេះជាម្លប់ពណ៌ខៀវអ្វី?

1711
00:49:20,480 --> 00:49:21,280
ទារកពណ៌ខៀវ។

1712
00:49:21,280 --> 00:49:22,120
អញ្ចឹង...

1713
00:49:22,120 --> 00:49:23,760
ពេល​កូន​ពាក់​វា​ពណ៌​ខៀវ

1714
00:49:23,760 --> 00:49:24,200
មែនទេ?

1715
00:49:24,200 --> 00:49:25,680
តាមពិតមានពណ៌មួយហៅថា ពណ៌ខៀវទារក។

1716
00:49:26,920 --> 00:49:28,080
ខ្ញុំក៏មិនមែនជាកូនរបស់អ្នកដែរឬ?

1717
00:49:28,200 --> 00:49:28,840
អ្នកគឺជា។

1718
00:49:29,600 --> 00:49:30,680
ទារក អ្នកក៏ជាទារកដែរ។

1719
00:49:31,640 --> 00:49:32,480
អ្នកគឺជាកូនធំ។

1720
00:49:32,680 --> 00:49:33,480
ខ្ញុំនឹងនិយាយបែបនោះ។

1721
00:49:38,400 --> 00:49:38,800
ពេលវេលាល្អឥតខ្ចោះ។

1722
00:49:39,080 --> 00:49:40,320
បន្ទាប់មកអនុញ្ញាតឱ្យខ្ញុំចេញ

1723
00:49:40,320 --> 00:49:41,000
អំណោយជាមុន។

1724
00:49:41,920 --> 00:49:42,960
អរគុណ Fang ។

1725
00:49:43,320 --> 00:49:44,720
ខ្ញុំទទួលបានទាំងនេះ

1726
00:49:45,120 --> 00:49:46,320
ពី Suzhou ។

1727
00:49:46,320 --> 00:49:47,400
អរគុណ Fang ។

1728
00:49:47,400 --> 00:49:48,480
មនុស្សគ្រប់រូបគឺខុសគ្នា។

1729
00:49:48,480 --> 00:49:49,560
ចាំមើលថានេះជាអ្នកណា។

1730
00:49:51,160 --> 00:49:52,120
នេះសម្រាប់ស៊ី។

1731
00:49:52,960 --> 00:49:54,080
មេអំបៅតូចមួយ។

1732
00:49:54,080 --> 00:49:55,240
សូមអរគុណ។ វាស្អាតណាស់។

1733
00:49:56,280 --> 00:49:57,480
មួយនេះ

1734
00:49:57,480 --> 00:49:58,480
សម្រាប់ Kaiyi ។

1735
00:49:58,480 --> 00:49:59,240
ស្អាតណាស់

1736
00:49:59,240 --> 00:50:00,080
វាមានការរចនាទំពាំងបាយជូរ។

1737
00:50:00,880 --> 00:50:01,640
ស្អាតណាស់

1738
00:50:02,840 --> 00:50:04,120
នេះគឺសម្រាប់ Xing ។

1739
00:50:04,480 --> 00:50:06,160
ដោយសារតែមានផ្កាយតូចមួយនៅលើវា។

1740
00:50:06,720 --> 00:50:07,400
សូមអរគុណ។

1741
00:50:07,400 --> 00:50:08,840
វាជាការរចនា osmanthus ។

1742
00:50:09,120 --> 00:50:10,080
Osmanthus ។

1743
00:50:10,760 --> 00:50:11,640
សូមអរគុណ។

1744
00:50:12,560 --> 00:50:13,360
នេះជា...

1745
00:50:13,760 --> 00:50:15,200
នេះគឺសម្រាប់ Yue'er ។

1746
00:50:15,640 --> 00:50:16,160
វាមានពណ៌ស្វាយ។

1747
00:50:16,160 --> 00:50:16,760
សូមអរគុណ។

1748
00:50:16,760 --> 00:50:17,440
ខ្ញុំ​បាន​គិត​ថា​វា​បាន​

1749
00:50:17,440 --> 00:50:18,480
ពិតជាសាកសមនឹងអ្នក។

1750
00:50:19,200 --> 00:50:20,000
សូមអរគុណ។

1751
00:50:20,600 --> 00:50:21,840
យើងផ្គូផ្គង។

1752
00:50:21,840 --> 00:50:23,320
យើងធ្វើហើយ កៃយី។

1753
00:50:24,640 --> 00:50:26,400
បុរសអាចជ្រើសរើសដោយខ្លួនឯង។

1754
00:50:29,560 --> 00:50:30,800
បុរស, ជ្រើសរើសរបស់អ្នក។

1755
00:50:30,800 --> 00:50:31,720
ខ្ញុំនឹងយកមួយនេះ។

1756
00:50:31,960 --> 00:50:32,760
វាមានន័យ។

1757
00:50:33,680 --> 00:50:34,560
ហើយមានមួយទៀត

1758
00:50:35,120 --> 00:50:36,000
សម្រាប់ស៊ីលុន។

1759
00:50:38,040 --> 00:50:39,200
តើយើងអាចហៅ ស៊ីលុន បានទេ?

1760
00:50:39,200 --> 00:50:39,440
បាទ។

1761
00:50:39,440 --> 00:50:40,680
តោះហៅគាត់ឥឡូវនេះ។

1762
00:50:40,680 --> 00:50:42,240
តើគាត់នៅទីណាម៉ោងប៉ុន្មាន?

1763
00:50:42,800 --> 00:50:43,840
ប្រហែលជាថ្ងៃត្រង់។

1764
00:50:44,280 --> 00:50:45,400
វាគ្រាន់តែជាថ្ងៃត្រង់នៅទីនោះ។

1765
00:50:45,640 --> 00:50:46,440
ល្អឥតខ្ចោះ។

1766
00:50:46,880 --> 00:50:47,840
តោះធ្វើវា។

1767
00:50:52,040 --> 00:50:52,840
ទារក។

1768
00:50:53,400 --> 00:50:54,040
ជំរាបសួរ។

1769
00:50:54,480 --> 00:50:56,000
យើងកំពុងញ៉ាំអាហារពេលល្ងាចឥឡូវនេះ។

1770
00:50:56,640 --> 00:50:58,400
សួស្តី

1771
00:50:58,400 --> 00:50:59,560
ជំរាបសួរ។

1772
00:51:01,160 --> 00:51:02,640
ល្អណាស់ដែលបានឃើញគ្រប់គ្នា។

1773
00:51:04,080 --> 00:51:05,840
បូហានកំពុងគ្រវីក្បាលអ្នក។

1774
00:51:06,580 --> 00:51:07,960
ខ្ញុំកំពុងគ្រវីត្រឡប់មកវិញ

1775
00:51:07,960 --> 00:51:08,720
បូហាន។

1776
00:51:08,720 --> 00:51:10,200
ហ្វាងបានទទួលអ្នក។

1777
00:51:10,200 --> 00:51:11,320
អំណោយតិចតួច។

1778
00:51:14,200 --> 00:51:15,240
អរគុណ Fang ។

1779
00:51:16,320 --> 00:51:17,400
សូម​អរគុណ​លោក Fang ។

1780
00:51:17,840 --> 00:51:19,320
ដៃរបស់អ្នកនៅតែមិនជាសះស្បើយ?

1781
00:51:19,640 --> 00:51:20,240
ស្ទើរតែ។

1782
00:51:20,240 --> 00:51:21,200
ខ្ញុំគ្រាន់តែត្រូវការ

1783
00:51:21,680 --> 00:51:22,280
ដើម្បីសម្រាកវា។

1784
00:51:22,400 --> 00:51:23,760
មិនអីទេ ប្រយ័ត្ន។

1785
00:51:23,960 --> 00:51:25,000
ហើយខ្ញុំចង់ប្រាថ្នា

1786
00:51:25,000 --> 00:51:26,000
Fang រីករាយថ្ងៃកំណើត។

1787
00:51:26,000 --> 00:51:27,320
សូមអរគុណ។

1788
00:51:30,440 --> 00:51:32,600
តើអ្នកបានចម្អិនទាំងអស់ដោយខ្លួនឯងទេ?

1789
00:51:32,600 --> 00:51:33,480
បាទ។

1790
00:51:33,480 --> 00:51:34,760
Yue'er បាន​ធ្វើ​ការ​នេះ​។

1791
00:51:34,760 --> 00:51:35,960
តើអ្នកអាចបង្ហាញឱ្យខ្ញុំនូវទិដ្ឋភាពជិតស្និទ្ធ,

1792
00:51:35,960 --> 00:51:36,640
ទារក?

1793
00:51:37,680 --> 00:51:39,520
តើ​អ្នក​អាច​បង្ហាញ​ឱ្យ​ខ្ញុំ​ឃើញ​យ៉ាង​ជិត​ស្និទ្ធ​, ទារក​?

1794
00:51:41,400 --> 00:51:42,840
ឱ្យខ្ញុំទាយ។ នំប៉ាវទាំងនេះ...

1795
00:51:46,440 --> 00:51:47,360
ខ្ញុំប្រាកដ...

1796
00:51:47,360 --> 00:51:49,080
ខ្ញុំប្រាកដ

1797
00:51:49,360 --> 00:51:51,040
Yue'er មិនបានបង្កើតពួកគេពីដំបូងឡើយ។

1798
00:51:55,200 --> 00:51:56,720
ប៉ុន្តែនាងបានចម្អិនពួកគេ។

1799
00:51:57,040 --> 00:51:58,360
បាទ ខ្ញុំបានចម្អិនពួកគេ។

1800
00:51:58,360 --> 00:51:58,840
ពិតប្រាកដ។

1801
00:51:58,840 --> 00:51:59,640
មិនអីទេ។

1802
00:52:00,800 --> 00:52:01,680
គាត់សប្បាយចិត្តណាស់។

1803
00:52:01,680 --> 00:52:02,800
ខ្ញុំឆ្ងល់ថាហេតុអ្វី?

1804
00:52:03,400 --> 00:52:05,160
ខ្ញុំ​គ្រាន់​តែ​សប្បាយ​ចិត្ត​ពេល​បាន​ឮ​សំឡេង​របស់ Yue'er ។

1805
00:52:05,360 --> 00:52:06,160
មិនអីទេ។

1806
00:52:08,080 --> 00:52:08,600
មិនអីទេ។

1807
00:52:08,600 --> 00:52:10,360
ខ្ញុំនឹងមិនរក្សាអ្នកទៀតទេ។

1808
00:52:10,360 --> 00:52:11,480
ផ្តោតលើថ្នាក់របស់អ្នក។

1809
00:52:11,480 --> 00:52:12,360
នឹងមិនរក្សាអ្នក។

1810
00:52:12,360 --> 00:52:13,680
ខ្ញុំនឹងមិនចំណាយពេលរបស់អ្នកទៀតទេ។

1811
00:52:14,040 --> 00:52:17,400
លាហើយ

1812
00:52:17,400 --> 00:52:18,960
ខ្ញុំនឹងមើលថែ Yue'er ឱ្យបានល្អសម្រាប់អ្នក។

1813
00:52:20,440 --> 00:52:21,320
បាទ។

1814
00:52:21,600 --> 00:52:22,520
អរគុណ Kaiyi ។

1815
00:52:23,040 --> 00:52:24,000
យើងទាំងអស់គ្នានឹង។

1816
00:52:24,000 --> 00:52:25,440
យើងទាំងអស់គ្នានឹងមើលថែ Yue'er។

1817
00:52:25,440 --> 00:52:26,600
អរគុណអ្នកទាំងអស់គ្នា។

1818
00:52:26,720 --> 00:52:27,600
អរគុណអ្នកទាំងអស់គ្នា។

1819
00:52:27,760 --> 00:52:29,440
លាហើយ

1820
00:52:30,600 --> 00:52:31,400
លាហើយ

1821
00:52:32,240 --> 00:52:33,040
លាហើយ

1822
00:52:34,160 --> 00:52:36,040
របៀបដែលគាត់គ្រវីគឺគួរឱ្យអស់សំណើច។

1823
00:52:36,040 --> 00:52:37,000
គាត់បន្តធ្វើបែបនេះ។

1824
00:52:37,880 --> 00:52:38,680
លាហើយ

1825
00:52:38,960 --> 00:52:40,600
ញាក់សាច់បែបនេះ។

1826
00:52:43,360 --> 00:52:45,400
អ្នក​រាល់​គ្នា​នៅ​ទី​នោះ​មាន​កែវ​ហើយ​មែន​ទេ?

1827
00:52:45,400 --> 00:52:46,680
មានទឹកក្តៅ។

1828
00:52:46,680 --> 00:52:47,760
មានភេសជ្ជៈរបស់អ្នកទេ? មក។

1829
00:52:47,760 --> 00:52:48,240
ទាំងអស់គ្នាត្រៀមខ្លួនហើយឬនៅ?

1830
00:52:48,240 --> 00:52:49,480
Yu Yang កំពុង​ផ្តល់​នំ​មួយ​ទៀត។

1831
00:52:49,480 --> 00:52:50,080
ធ្វើនំដុត។

1832
00:52:50,080 --> 00:52:50,880
អ្នកធ្វើវាម្តងទៀត។

1833
00:52:50,880 --> 00:52:51,480
ខ្ញុំម្តងទៀត?

1834
00:52:51,480 --> 00:52:52,040
ដូចជានៅម៉ុងហ្គោលីខាងក្នុង។

1835
00:52:52,040 --> 00:52:53,480
Yu Yang បាន​ផ្តល់​នំ​នៅ​ទីនោះ​ផង​ដែរ​។

1836
00:52:54,000 --> 00:52:55,760
ទាំងអស់គ្នា បន្តញ៉ាំ និងផឹក។

1837
00:52:56,240 --> 00:52:58,080
មានអារម្មណ៍ថាធ្លាប់ស្គាល់មែនទេ?

1838
00:52:58,080 --> 00:52:58,840
បាទ វាធ្វើ។

1839
00:52:58,840 --> 00:52:59,640
ស៊ាំ។

1840
00:53:00,960 --> 00:53:01,440
រួមគ្នាម្តងទៀត។

1841
00:53:01,440 --> 00:53:02,600
យើង​បាន​ជួបជុំ​គ្នា​ម្ដង​ទៀត។

1842
00:53:12,520 --> 00:53:13,520
តោះញ៉ាំ។

1843
00:53:13,520 --> 00:53:14,440
ចូរយើងជីក។

1844
00:53:14,440 --> 00:53:15,520
ជីកចូល។

1845
00:53:15,920 --> 00:53:17,000
តោះញ៉ាំ។

1846
00:53:17,000 --> 00:53:18,320
ឆ្លងកាត់ខ្លះនៅទីនោះ។

1847
00:53:19,000 --> 00:53:20,940
ជូនខ្លះទៅ Si, Hewen ។

1848
00:53:20,940 --> 00:53:22,020
(ជួយធ្វើម្ហូប) សូមអរគុណ។

1849
00:53:22,920 --> 00:53:23,720
នៅទីនេះមានមួយដុំ។

1850
00:53:24,200 --> 00:53:25,000
នៅទីនេះអ្នកទៅ។

1851
00:53:27,080 --> 00:53:27,880
វាមិនអីទេ។

1852
00:53:27,880 --> 00:53:28,660
(ជួយបម្រើខ្លះ)

1853
00:53:29,120 --> 00:53:31,160
ហេ តោះ​ឆ្លង​កាត់។

1854
00:53:31,160 --> 00:53:31,440
នៅទីនេះ។

1855
00:53:31,440 --> 00:53:32,000
មួយៗ។

1856
00:53:32,240 --> 00:53:33,080
ល្អឥតខ្ចោះ។

1857
00:53:33,080 --> 00:53:34,020
ឆ្អឹងជំនីរទាំងនេះមានរសជាតិឆ្ងាញ់។

1858
00:53:34,020 --> 00:53:34,740
(ឆ្អឹងជំនីរទទួលបានការពិនិត្យដ៏ឈ្លើយ)

1859
00:53:35,120 --> 00:53:35,920
ឆ្អឹងជំនីរល្អណាស់។

1860
00:53:36,160 --> 00:53:36,880
តើអ្នកណាជាអ្នកបង្កើតឆ្អឹងជំនីរទាំងនេះ?

1861
00:53:36,880 --> 00:53:37,240
Xiaoyu ។

1862
00:53:37,400 --> 00:53:38,320
Xiaoyu បានបង្កើតពួកគេ។

1863
00:53:39,160 --> 00:53:40,580
តើខ្ញុំទើបតែលឺនរណាម្នាក់សរសើរខ្ញុំទេ?

1864
00:53:40,580 --> 00:53:41,080
(មិនអាចលាក់ការរំភើបរបស់នាង)

1865
00:53:41,080 --> 00:53:42,480
ទាំង​នេះ​ជា​ឆ្អឹង​ជំនីរ​ជូរ​ផ្អែម​មែន​ទេ Xiaoyu?

1866
00:53:42,480 --> 00:53:43,120
បាទ។

1867
00:53:43,120 --> 00:53:43,920
ឆ្ងាញ់។

1868
00:53:45,640 --> 00:53:46,320
មានមាន់នៅទីនេះ។

1869
00:53:46,320 --> 00:53:47,420
(ចិញ្ចឹមគាត់)

1870
00:53:47,760 --> 00:53:48,520
អ្នកមានខ្លះ។

1871
00:53:48,520 --> 00:53:49,240
ខ្ញុំល្អណាស់។

1872
00:53:49,360 --> 00:53:50,280
ខ្ញុំនឹងញ៉ាំការ៉ុត។

1873
00:53:50,280 --> 00:53:51,080
អ្នកញ៉ាំសាច់មាន់។

1874
00:53:54,440 --> 00:53:55,480
(ខាំតូច) គ្រាន់តែខាំតូចទេ?

1875
00:53:57,880 --> 00:53:58,680
ស៊ុតចៀនជាមួយប៉េងប៉ោះ។

1876
00:53:59,320 --> 00:54:00,120
មិនអីទេ។

1877
00:54:00,720 --> 00:54:01,560
តើអ្នកចង់បានអ្វី?

1878
00:54:01,560 --> 00:54:02,560
ប្រហិត​កូរ។

1879
00:54:02,560 --> 00:54:03,360
ប្រហិតបំពង?

1880
00:54:05,160 --> 00:54:06,600
តោះ​ ប្រហិត​ចៀន​បន្តិច​ទៅ។

1881
00:54:08,480 --> 00:54:09,040
តើវានៅឯណា?

1882
00:54:09,040 --> 00:54:09,440
នៅទីនេះ។

1883
00:54:09,440 --> 00:54:10,040
នៅទីនេះ។

1884
00:54:10,600 --> 00:54:11,520
គ្រាន់តែយកវា។

1885
00:54:11,520 --> 00:54:12,240
យកវា។

1886
00:54:12,240 --> 00:54:12,680
ទៅមុខ។

1887
00:54:12,680 --> 00:54:13,400
យកវា។

1888
00:54:13,400 --> 00:54:14,960
ខ្ញុំ​នឹង​យក​វា​ហើយ​ដក​ចេញ។

1889
00:54:14,960 --> 00:54:15,320
ប្រាកដ។

1890
00:54:15,320 --> 00:54:16,200
បន្ទាប់មកខ្ញុំនឹងយកវាមកវិញ។

1891
00:54:16,200 --> 00:54:17,800
ស៊ី តើអ្នកអាចអោយខ្ញុំខ្លះបានទេ?

1892
00:54:17,800 --> 00:54:18,840
មាន់ស្រែ?

1893
00:54:18,840 --> 00:54:19,440
សូមអរគុណ។

1894
00:54:21,440 --> 00:54:22,600
វាមិនអីទេ។ ខ្ញុំបានទទួលវាហើយ។

1895
00:54:22,940 --> 00:54:24,260
(រក្សាក្រុមហ៊ុនរបស់នាង)

1896
00:54:26,000 --> 00:54:26,800
សូមអរគុណ។

1897
00:54:27,520 --> 00:54:28,840
ខ្ញុំបានសាកល្បងមាន់គុយរីរបស់អ្នកមុន។

1898
00:54:28,840 --> 00:54:29,600
វាពិតជាល្អណាស់។

1899
00:54:30,960 --> 00:54:32,480
ហេតុអ្វីបានជាអ្នកធ្វើមាន់គុយរី?

1900
00:54:32,580 --> 00:54:33,040
(ចង់ដឹងចង់ឃើញ)

1901
00:54:33,040 --> 00:54:34,440
ជាការប្រសើរណាស់ ការធ្វើដំណើររបស់យើងបានបញ្ចប់នៅប្រទេសថៃ។

1902
00:54:34,440 --> 00:54:36,000
ហើយ​ប្រទេស​ថៃ​ត្រូវ​បាន​គេ​ស្គាល់

1903
00:54:36,240 --> 00:54:37,120
សម្រាប់​ការី​របស់​វា​។

1904
00:54:37,120 --> 00:54:38,760
ចាប់តាំងពីយើងទាំងអស់គ្នាម្តងទៀត,

1905
00:54:38,960 --> 00:54:39,760
វាជាការបោះចោលដ៏ល្អ។

1906
00:54:41,920 --> 00:54:43,440
ទឹកដោះគោជូរនេះឆ្ងាញ់ហើយត្រជាក់។

1907
00:54:43,440 --> 00:54:44,120
ខ្ញុំចូលចិត្តវា។

1908
00:54:44,120 --> 00:54:44,700
(បង្ហាញដោយភ្នែករបស់គាត់) ទឹកដោះគោជូរត្រជាក់។

1909
00:54:44,820 --> 00:54:45,440
(ទទួលបានការណែនាំ)

1910
00:54:45,440 --> 00:54:46,880
(ទទួលបានព័ត៌មានជំនួយ) តើអ្នកណានាំយកទឹកដោះគោជូរ?

1911
00:54:46,880 --> 00:54:47,680
ទឹកដោះគោជូរ?

1912
00:54:48,200 --> 00:54:49,440
តើមានរឿងនៅពីក្រោយវាទេ?

1913
00:54:49,440 --> 00:54:50,340
(ចូលរួមលេងសើច)

1914
00:54:51,520 --> 00:54:52,440
ខ្ញុំសង្ឃឹមថាចំណងរបស់យើង។

1915
00:54:52,440 --> 00:54:53,560
នៅតែក្រាស់ដូចទឹកដោះគោជូរ។

1916
00:54:53,940 --> 00:54:54,980
(អ្នកនិយាយត្រង់ណា)

1917
00:54:56,080 --> 00:54:56,760
អ្នកបានបង្កើតវានៅនឹងកន្លែង។

1918
00:54:58,080 --> 00:54:59,080
សាច់ជ្រូកឆ្អិនពីរដងពិតជាល្អណាស់។

1919
00:55:00,180 --> 00:55:01,220
(អ្នកទាំងពីរពិតជាស៊ីសង្វាក់គ្នា)

1920
00:55:01,800 --> 00:55:03,680
ដូចជាមិត្តភាពរបស់យើង,

1921
00:55:03,680 --> 00:55:04,920
វាកាន់តែឆ្អិនឡើងវិញ

1922
00:55:04,920 --> 00:55:06,080
វាកាន់តែមានរសជាតិឆ្ងាញ់។

1923
00:55:06,080 --> 00:55:07,220
(ដូចជាមិត្តភាពរបស់យើង វាកាន់តែប្រសើរឡើងរាល់ពេលដែលយើងជួបជុំគ្នា)

1924
00:55:09,020 --> 00:55:10,220
(នោះជាវត្ថុ)

1925
00:55:10,640 --> 00:55:11,080
មែនទេ?

1926
00:55:11,080 --> 00:55:12,880
អ្នកមានបន្ទាត់ឆ្លាតទាំងអស់,

1927
00:55:12,880 --> 00:55:13,640
យូយ៉ាង

1928
00:55:13,880 --> 00:55:15,440
ចុះស៊ុតចំបើងជាមួយប៉េងប៉ោះវិញ?

1929
00:55:15,440 --> 00:55:16,800
ខ្ញុំសង្ឃឹមថារបស់យើង។

1930
00:55:16,800 --> 00:55:18,000
មិត្តភាពស្នាក់នៅ

1931
00:55:18,000 --> 00:55:19,240
សាមញ្ញនិងយូរអង្វែង។

1932
00:55:21,560 --> 00:55:22,280
ទម្លាក់មីក្រូ។

1933
00:55:22,640 --> 00:55:24,220
ចុះ​ប្រហិត​របស់​អ្នក​វិញ?

1934
00:55:24,220 --> 00:55:25,120
(វេនរបស់អ្នក)

1935
00:55:25,120 --> 00:55:25,720
ប្រាប់យើង។

1936
00:55:26,520 --> 00:55:28,280
ខ្ញុំពិតជានឹងធ្វើវា

1937
00:55:29,320 --> 00:55:31,200
សម្រាប់អ្នកមួយថ្ងៃមុនពេលអ្នកទៅមន្ទីរពេទ្យ។

1938
00:55:31,200 --> 00:55:32,160
(ការសន្យាពី Signal House) ខ្ញុំបានរៀបចំអ្វីៗគ្រប់យ៉ាងរួចហើយ

1939
00:55:32,160 --> 00:55:33,120
ប៉ុន្តែមិនដែលត្រូវចំអិនវាទេ។

1940
00:55:33,400 --> 00:55:34,440
ហើយឥឡូវនេះយើងនៅទីនេះ។

1941
00:55:34,440 --> 00:55:35,880
យើងទាំងអស់គ្នាម្តងទៀត។

1942
00:55:36,200 --> 00:55:37,680
ទីបំផុតចែករំលែក។ រង្វង់ពេញ។

1943
00:55:37,800 --> 00:55:38,600
និងនំប៉ាវ។

1944
00:55:39,040 --> 00:55:40,200
នំប៉ាវតំណាងឱ្យការជួបជុំគ្នា,

1945
00:55:40,200 --> 00:55:41,160
មែនទេ?

1946
00:55:41,160 --> 00:55:42,600
បាទ! Yue'er ចម្អិនពួកគេ។

1947
00:55:42,920 --> 00:55:44,840
នំប៉ាវមើលទៅដូចជាមាស,

1948
00:55:44,840 --> 00:55:45,600
ដូច្នេះខ្ញុំសូមជូនពរអ្នកគ្រប់គ្នា

1949
00:55:45,600 --> 00:55:47,000
ទ្រព្យសម្បត្តិជាច្រើន។

1950
00:55:47,000 --> 00:55:47,400
ល្អណាស់។

1951
00:55:47,400 --> 00:55:48,440
សូម​ឲ្យ​សំណាង​បាន​មក​ដល់​អ្នក។

1952
00:55:48,440 --> 00:55:49,560
ខ្ញុំចូលចិត្តវា។

1953
00:55:49,720 --> 00:55:51,200
បាទ មុខម្ហូបនីមួយៗមាន

1954
00:55:51,200 --> 00:55:52,080
អត្ថន័យរបស់វា។

1955
00:55:56,920 --> 00:55:57,200
បាទ។

1956
